@if (IsVisible)
{
    <div class="modal-backdrop">
        <div class="modal-card animate-slide-up">
            <div class="modal-icon-container">
                @if (ConfirmButtonClass == "btn-danger-modal")
                {
                    @* Iconiță specifică pentru ștergere EnVogue *@
                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#d946ef" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                }
                else
                {
                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#d946ef" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                }
            </div>

            <h3 class="modal-title-envogue">@Title</h3>
            <p class="modal-text-envogue">@Message</p>

            <div class="modal-actions-envogue">
                <button class="btn-envogue-secondary" @onclick="OnCancel">@CancelText</button>
                <button class="btn-envogue-confirm @ConfirmButtonClass" @onclick="OnConfirm">@ConfirmText</button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4); /* Overlay mai soft */
        backdrop-filter: blur(10px); /* Blur editorial */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
    }

    .modal-card {
        width: 90%;
        max-width: 320px;
        padding: 40px 24px;
        text-align: center;
        background: white; /* Card alb ca în Item Details */
        border-radius: 35px; /* Colțuri foarte rotunjite */
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    }

    .modal-icon-container {
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
    }

    .modal-title-envogue {
        font-family: 'Playfair Display', serif;
        font-size: 24px;
        font-weight: 900;
        color: #2d1b24;
        margin: 0 0 10px 0;
    }

    .modal-text-envogue {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #7a5c68;
        opacity: 0.8;
        margin-bottom: 30px;
        line-height: 1.5;
    }

    .modal-actions-envogue {
        display: flex;
        gap: 12px;
    }

    .btn-envogue-secondary, .btn-envogue-confirm {
        flex: 1;
        padding: 14px;
        border-radius: 16px;
        border: none;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: 0.2s;
    }

    /* Butonul de anulare (Keep it) */
    .btn-envogue-secondary {
        background: #f5f5f5;
        color: #2d1b24;
    }

    /* Butonul de confirmare (Delete) */
    .btn-envogue-confirm {
        background: #2d1b24;
        color: white;
    }

    /* Varianta roz dacă e nevoie */
    .btn-accent-modal {
        background: #d946ef !important;
    }

    .btn-envogue-secondary:hover, .btn-envogue-confirm:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";

    // 💡 Trimite "btn-danger-modal" pentru roșu sau "btn-accent-modal" pentru roz
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn-accent-modal";

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}