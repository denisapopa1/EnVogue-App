@using EnVogue.Services
@inject NotificationService NotificationService
@implements IDisposable

@if (isVisible)
{
    @* Folosim style inline pentru z-index ca să fim siguri că nu e suprascris *@
    <div class="toast-notification @type animate-slide-in"
         style="z-index: 9999999 !important; position: fixed !important;">
        <div class="toast-content">
            <span class="toast-icon">@(type == "success" ? "✓" : "⚠")</span>
            <span class="toast-message">@message</span>
        </div>
    </div>
}

<style>
    .toast-notification {
        top: 25px; /* Îl mutăm sus pentru a fi vizibil deasupra box-ului */
        left: 50%;
        transform: translateX(-50%);
        padding: 16px 32px;
        border-radius: 50px;
        color: white !important;
        font-weight: 800;
        box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        background: #000000 !important; /* Negru pur pentru contrast pe roz */
        display: flex;
        align-items: center;
        min-width: 280px;
        justify-content: center;
    }

    .error {
        background: #ff2d55 !important;
    }

    .success {
        background: #28a745 !important;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translate(-50%, -20px);
        }

        to {
            opacity: 1;
            transform: translate(-50%, 0);
        }
    }
</style>

@code {
    private bool isVisible;
    private string message = "";
    private string type = "success";

    protected override void OnInitialized()
    {
        NotificationService.OnShow += ShowToast;
    }

    private void ShowToast(string msg, string t)
    {
        // InvokeAsync este critic aici pentru a randa pe UI thread
        InvokeAsync(async () =>
        {
            message = msg;
            type = t;
            isVisible = true;
            StateHasChanged(); // Forțează browserul să deseneze

            await Task.Delay(3500); // Îl lăsăm puțin mai mult vizibil

            isVisible = false;
            StateHasChanged();
        });
    }

    public void Dispose() => NotificationService.OnShow -= ShowToast;
}