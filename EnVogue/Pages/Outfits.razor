@code {
    private List<Outfit> SavedOutfits = new();
    private List<Outfit> FilteredOutfits = new();
    private string SearchTerm = "";
    private string SortBy = "Newest";
    private string SelectedStyle = "All";
    private bool ShowOnlyFavorites;
    private bool isSortOpen;
    private bool isLoading = true;
    private readonly List<string> StyleOptions = new() { "All", "Casual Style", "Elegant Style", "Formal Wear", "Sporty Look" };

    private bool HasActivePanelFilters => SelectedStyle != "All" || ShowOnlyFavorites || SortBy != "Newest";
    private bool HasActiveSearch => !string.IsNullOrWhiteSpace(SearchTerm);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await WardrobeService.InitializeAsync();
        RefreshData();
        WardrobeService.OnChange += HandleOnChange;
        isLoading = false;
    }

    private void HandleOnChange() => InvokeAsync(RefreshData);

    private void RefreshData()
    {
        SavedOutfits = WardrobeService
            .GetAllOutfits()
            .Where(ShouldAppearOnLooks)
            .ToList();
        ApplyFilters();
        StateHasChanged();
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void HandleSearchConfirm()
    {
        ApplyFilters(isStrict: true);
    }

    private void HandleSearchEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearchConfirm();
        }
    }

    private void ToggleSortPanel()
    {
        isSortOpen = !isSortOpen;
    }

    private void SetSort(string sort)
    {
        SortBy = sort;
        ShowOnlyFavorites = false;
        ApplyFilters();
    }

    private void SetStyle(string style)
    {
        SelectedStyle = style;
        ApplyFilters();
    }

    private void ToggleFavoriteFilter()
    {
        ShowOnlyFavorites = !ShowOnlyFavorites;
        if (ShowOnlyFavorites)
        {
            SortBy = "";
        }
        else
        {
            SortBy = "Newest";
        }
        ApplyFilters();
    }

    private void ClearPanelFilters()
    {
        SelectedStyle = "All";
        SortBy = "Newest";
        ShowOnlyFavorites = false;
        ApplyFilters();
    }

    private void ClearSearch()
    {
        SearchTerm = "";
        ApplyFilters();
    }

    private void ApplyFilters(bool isStrict = false)
    {
        IEnumerable<Outfit> query = SavedOutfits;

        if (ShowOnlyFavorites)
        {
            query = query.Where(o => o.IsFavorite);
        }

        if (SelectedStyle != "All")
        {
            query = query.Where(o => string.Equals(o.Occasion, SelectedStyle, StringComparison.OrdinalIgnoreCase));
        }

        var search = SearchTerm.Trim().ToLowerInvariant();
        if (!string.IsNullOrEmpty(search))
        {
            if (isStrict)
            {
                query = query.Where(o => OutfitMatchesStrict(o, search));
            }
            else
            {
                var keywords = search.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                query = query.Where(o => OutfitMatchesKeywords(o, keywords));
            }
        }

        FilteredOutfits = SortBy switch
        {
            "Oldest" => query.OrderBy(o => o.CreatedDate).ToList(),
            "Name" => query.OrderBy(o => o.Name).ToList(),
            "" => query.ToList(),
            _ => query.OrderByDescending(o => o.CreatedDate).ToList()
        };
    }

    private async Task ToggleFavorite(Outfit outfit)
    {
        var wasFavorite = outfit.IsFavorite;
        var updatedSuccessfully = await WardrobeService.ToggleFavorite(outfit.Id);
        RefreshData();

        if (!updatedSuccessfully)
        {
            Toast.Show("Favorite status could not be saved.", "error");
            return;
        }

        if (!wasFavorite)
        {
            Toast.Show("Outfit added to favorites.", "success");
        }
        else
        {
            Toast.Show("Outfit removed from favorites.", "info");
        }
    }

    private void OpenOutfitDetails(int outfitId)
    {
        Nav.NavigateTo($"/outfit-details/{outfitId}");
    }

    private List<ClothingItem> GetSortedItems(List<ClothingItem> items)
    {
        var order = new List<string> { "Outerwear", "Tops", "Dress", "Bottoms", "Shoes", "Accessories" };
        return items.OrderBy(i =>
        {
            var idx = order.IndexOf(i.CategoryName ?? "");
            return idx == -1 ? 99 : idx;
        }).ToList();
    }

    private static bool OutfitMatchesKeywords(Outfit outfit, string[] keywords)
    {
        return keywords.All(keyword =>
            (outfit.Name?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (outfit.Occasion?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
            outfit.Items.Any(item =>
                (item.Brand?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.Name?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.CategoryName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.SubcategoryName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.Style?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.Season?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.Color?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
            )
        );
    }

    private static bool OutfitMatchesStrict(Outfit outfit, string search)
    {
        return string.Equals(outfit.Name, search, StringComparison.OrdinalIgnoreCase) ||
               string.Equals(outfit.Occasion, search, StringComparison.OrdinalIgnoreCase) ||
               outfit.Items.Any(item =>
                   string.Equals(item.Brand, search, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(item.Name, search, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(item.CategoryName, search, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(item.SubcategoryName, search, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(item.Style, search, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(item.Season, search, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(item.Color, search, StringComparison.OrdinalIgnoreCase)
               );
    }

    private static bool ShouldAppearOnLooks(Outfit outfit)
    {
        // Looks should surface both manually created outfits and AI-generated outfits.
        // Existing outfits that don't have a source marker yet remain visible as well.
        return outfit.Items.Any() &&
               (string.IsNullOrWhiteSpace(outfit.CreationSource) ||
                string.Equals(outfit.CreationSource, "Manual", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(outfit.CreationSource, "AI", StringComparison.OrdinalIgnoreCase));
    }

    private string GetPreviewGridClass(int itemCount)
    {
        if (itemCount <= 1)
        {
            return "preview-grid one-item";
        }

        if (itemCount == 2)
        {
            return "preview-grid two-items";
        }

        if (itemCount == 3)
        {
            return "preview-grid three-items";
        }

        if (itemCount == 4)
        {
            return "preview-grid four-items";
        }

        return "preview-grid many-items";
    }

    private string GetPreviewShellClass(int itemCount)
    {
        return "look-preview";
    }

    private string GetImageSource(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath) || imagePath == "du")
        {
            return "Images/placeholder.png";
        }

        if (imagePath.StartsWith("Images/", StringComparison.OrdinalIgnoreCase) ||
            imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return imagePath;
        }

        var fileName = System.IO.Path.GetFileName(imagePath);
        return $"https://localhost:7081/uploads/images/{fileName}";
    }

    public void Dispose()
    {
        WardrobeService.OnChange -= HandleOnChange;
    }
}

