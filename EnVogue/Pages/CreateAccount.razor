@page "/create-account"
@using EnVogue.Models
@using System.ComponentModel.DataAnnotations
@using EnVogue.Services

<EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />

    <div class="page-container with-nav" style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 100px);">
        <div class="card animate-fade-in form-limit" style="max-width: 420px; width: 100%;">
            <div class="center" style="margin-bottom: 24px;">
                <div class="brand" style="font-size: 28px;">EnVogue</div>
                <p class="page-subtitle" style="margin-top: 6px;">Join Smart Wardrobe today</p>
            </div>

            <div class="input-group">
                <label>Email</label>
                <input type="email" class="input-field" placeholder="Enter your email" @bind="registerModel.Email" />
                <ValidationMessage For="@(() => registerModel.Email)" />
            </div>

            <div class="input-group">
                <label>Password</label>
                <div style="position: relative;">
                    <input type="@passwordFieldType" class="input-field" placeholder="Enter your password" @bind="registerModel.Password" style="padding-right: 40px;" />
                    <button type="button" @onclick="TogglePassword"
                            style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--text-2); cursor: pointer;">
                        @(passwordFieldType == "password" ? "👁️" : "🙈")
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.Password)" />
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <div style="position: relative;">
                    <input type="@confirmPasswordFieldType" class="input-field" placeholder="Re-enter your password" @bind="registerModel.ConfirmPassword" style="padding-right: 40px;" />
                    <button type="button" @onclick="ToggleConfirmPassword"
                            style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--text-2); cursor: pointer;">
                        @(confirmPasswordFieldType == "password" ? "👁️" : "🙈")
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
            </div>

            <button class="btn-primary" style="width: 100%; margin-bottom: 12px;" type="submit" disabled="@(!formIsValid)">Create account</button>

            <div class="center">
                <a href="/login" style="color: var(--text-2); font-size: 14px; text-decoration: none;">Already have an account?</a>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private RegisterModel registerModel = new();

    private string passwordFieldType = "password";
    private string confirmPasswordFieldType = "password";

    private bool formIsValid =>
        !string.IsNullOrWhiteSpace(registerModel.Email) &&
        !string.IsNullOrWhiteSpace(registerModel.Password) &&
        !string.IsNullOrWhiteSpace(registerModel.ConfirmPassword);

    private void TogglePassword()
    {
        passwordFieldType = passwordFieldType == "password" ? "text" : "password";
    }

    private void ToggleConfirmPassword()
    {
        confirmPasswordFieldType = confirmPasswordFieldType == "password" ? "text" : "password";
    }

    private void HandleRegister()
    {
        // Aici ulterior poți integra backend / Identity
        UserState.Login(registerModel.Email!);
        NavigationManager.NavigateTo("/home");
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private UserState UserState { get; set; } = default!;
}
