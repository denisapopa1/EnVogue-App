@page "/create-account"
@layout EmptyLayout
@using EnVogue.Models
@inject NavigationManager NavigationManager
@inject UserState UserState
@inject WardrobeServices WardrobeService
@inject IJSRuntime JS

<div class="login-wrapper" @onclick="BlurEverything">
    @if (isNavigating)
    {
        <div class="nav-overlay">
            <div class="loader"></div>
        </div>
    }

    @* REPARAȚIE: Adăugat stopPropagation pentru a preveni închiderea tastaturii la click *@
    <EditForm Model="@registerModel"
              OnValidSubmit="HandleRegister"
              class="@FormCssClass"
              @onclick:stopPropagation>

        <DataAnnotationsValidator />

        <div class="login-header">
            <div class="logo-container">
                <div class="circular-logo">
                    <img src="Images/elegant_pink_fashion_logo_envogue.png" alt="EnVogue Logo" />
                </div>
            </div>

            <h1 class="main-title">Join EnVogue</h1>
            <p class="subtitle">Create your smart wardrobe today</p>
        </div>

        <div class="form-group">
            <label>EMAIL</label>
            <InputText type="email"
                       class="custom-input bold-text"
                       placeholder="hello@example.com"
                       @bind-Value="registerModel.Email" />
            <div class="error-container">
                <ValidationMessage For="@(() => registerModel.Email)" />
            </div>
        </div>

        <div class="form-group">
            <label>PASSWORD</label>
            <div class="password-wrapper">
                <InputText type="@passwordFieldType"
                           class="custom-input bold-text"
                           placeholder="••••••••"
                           @bind-Value="registerModel.Password" />
                <button type="button"
                        class="toggle-pass"
                        @onclick="TogglePassword">
                    <span class="eye-icon">
                        @(passwordFieldType == "password" ? "👁" : "🙈")
                    </span>
                </button>
            </div>
            <div class="error-container">
                <ValidationMessage For="@(() => registerModel.Password)" />
            </div>
        </div>

        <div class="form-group">
            <label>CONFIRM PASSWORD</label>
            <div class="password-wrapper">
                <InputText type="@confirmPasswordFieldType"
                           class="custom-input bold-text"
                           placeholder="••••••••"
                           @bind-Value="registerModel.ConfirmPassword" />
                <button type="button"
                        class="toggle-pass"
                        @onclick="ToggleConfirmPassword">
                    <span class="eye-icon">
                        @(confirmPasswordFieldType == "password" ? "👁" : "🙈")
                    </span>
                </button>
            </div>
            <div class="error-container">
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="login-error-alert animate-fade-in">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <button type="submit"
                class="create-btn bold-text"
                disabled="@isLoading">
            @if (isLoading)
            {
                <span>Creating Account...</span>
            }
            else
            {
                <span>Create Account →</span>
            }
        </button>

        <div class="login-footer">
            <span class="bold-text">Already have an account? </span>
            <a href="/login" class="highlight-link bold-text">Log In</a>
        </div>
    </EditForm>
</div>

<style>
    * {
        -webkit-tap-highlight-color: transparent !important;
        outline: none !important;
    }

    *:focus, *:active {
        outline: none !important;
        box-shadow: none !important;
    }

    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fce7f3;
        font-family: 'Inter', sans-serif;
    }

    .login-form {
        width: 100%;
        max-width: 400px;
        padding: 20px;
        text-align: center;
        transition: opacity 0.2s;
    }

    .login-form.navigating {
        opacity: 0 !important;
    }

    .logo-container {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .circular-logo {
        width: 80px;
        height: 80px;
        background: #1a1a1a;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .circular-logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .main-title {
        color: #d946ef;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .subtitle {
        color: #7a5c68;
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 35px;
    }

    .form-group {
        text-align: left;
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-size: 11px;
        font-weight: 800;
        color: #7a5c68;
        margin-bottom: 8px;
        letter-spacing: 0.05em;
    }

    .custom-input {
        width: 100%;
        padding: 14px 20px;
        border-radius: 12px;
        border: none;
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        font-weight: 700;
        color: #2d1b24;
        box-sizing: border-box;
    }

    .password-wrapper {
        position: relative;
    }

    .toggle-pass {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        opacity: 0.6;
        font-size: 18px;
    }

    .login-error-alert {
        background-color: #fff1f2;
        color: #be123c;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(190, 18, 60, 0.1);
        box-shadow: 0 4px 12px rgba(190, 18, 60, 0.05);
        text-align: left;
    }

    .create-btn {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 15px;
        background-color: #d946ef;
        color: white;
        font-weight: 800;
        font-size: 16px;
        box-shadow: 0 8px 20px rgba(217,70,239,0.3);
        cursor: pointer;
        margin-top: 15px;
    }

    .highlight-link {
        color: #d946ef;
        text-decoration: none;
        font-weight: 800;
    }

    .login-footer {
        margin-top: 25px;
        font-size: 14px;
        color: #7a5c68;
    }

    .nav-overlay {
        position: fixed;
        inset: 0;
        background: #fce7f3;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loader {
        width: 40px;
        height: 40px;
        border: 4px solid rgba(217,70,239,0.1);
        border-top: 4px solid #d946ef;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .error-container {
        margin-top: 4px;
        min-height: 20px;
    }

    .validation-message {
        color: #be123c !important;
        font-size: 12px;
        font-weight: 800 !important;
        background-color: rgba(255, 255, 255, 0.5);
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
    }
</style>

@code {
    private RegisterModel registerModel = new();
    private bool isLoading;
    private bool isNavigating;
    private string? errorMessage; 
    private string passwordFieldType = "password";
    private string confirmPasswordFieldType = "password";

    private string FormCssClass =>
        isNavigating ? "login-form navigating" : "login-form";

    private bool formIsValid =>
        !string.IsNullOrWhiteSpace(registerModel.Email) &&
        !string.IsNullOrWhiteSpace(registerModel.Password) &&
        !string.IsNullOrWhiteSpace(registerModel.ConfirmPassword);

    private async Task BlurEverything()
        => await JS.InvokeVoidAsync("document.activeElement.blur");

    private void TogglePassword()
        => passwordFieldType = passwordFieldType == "password" ? "text" : "password";

    private void ToggleConfirmPassword()
        => confirmPasswordFieldType = confirmPasswordFieldType == "password" ? "text" : "password";

    private async Task HandleRegister()
    {
        errorMessage = null; 

        if (!formIsValid)
        {
            errorMessage = "Please fill in all fields to create your account.";
            return;
        }

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (isLoading) return;

        isLoading = true;
        WardrobeService.SetLoggedInUser(registerModel.Email!);
        UserState.Login(registerModel.Email!);

        isNavigating = true;
        StateHasChanged();
        
        await Task.Delay(50);
        NavigationManager.NavigateTo("/home");
    }
}