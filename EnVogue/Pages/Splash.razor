@page "/"
@layout EmptyLayout
@inject NavigationManager Nav

<div class="onboarding-container" tabindex="-1">
    <div class="onboarding-bg">
        <img src="Images/luxury_fashion_splash_image.png" alt="Luxury Fashion" />
    </div>

    <div class="glass-sidebar">
        <div class="onboarding-content">
            <div class="header-section">
                <span class="brand-tag">ENVOGUE</span>
            </div>

            <div class="main-text">
                <h1>Your Style,</h1>
                <h1 class="highlight">Your Way</h1>
                <h1>Every Day</h1>
            </div>

            <div class="footer-section">
                <button @onclick='() => Nav.NavigateTo("/login")' class="next-circle-btn">
                    <span class="arrow-icon">→</span>
                </button>

                <div class="pagination-dots">
                    <span class="dot active"></span>
                    <span class="dot"></span>
                </div>
            </div>
        </div>
    </div>

    @* Butonul SKIP este acum poziționat fix în dreapta sus *@
    <button @onclick='() => Nav.NavigateTo("/login")' class="skip-btn-right">SKIP</button>
</div>
<style>
.onboarding-container,
.onboarding-container:focus,
.onboarding-container:active,
h1:focus {
    outline: none !important;
    box-shadow: none !important;
    -webkit-tap-highlight-color: transparent;
}

html, body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

.onboarding-container {
    position: relative;
    width: 100%;
    height: 100dvh;
    background: #000;
    color: white;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
}

/* IMAGINEA - desktop: aliniat la centru-dreapta pentru a arăta modelul */
.onboarding-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
}

        .onboarding-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: 75% center; /* focalizat pe dreapta unde e modelul */
        }
/* SIDEBAR DESKTOP - stânga, blur, ~40% lățime */
    .glass-sidebar {
        position: absolute;
        left: 0;
        top: 0;
        width: 50%; /* exact jumătate din ecran */
        height: 100%;
        z-index: 2;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
    }

    .onboarding-content {
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0 10% 10%;
        box-sizing: border-box;
    }


.skip-btn-right {
    position: absolute;
    top: 35px;
    right: 35px;
    background: none;
    border: none;
    color: white;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.2em;
    cursor: pointer;
    opacity: 0.6;
    z-index: 20;
    padding: 8px 12px;
    text-transform: uppercase;
}

.skip-btn-right:hover {
    opacity: 1;
}

.header-section {
    margin-bottom: 20px;
}

.brand-tag {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.5em;
    color: #ff7eb9;
    text-transform: uppercase;
}

.main-text {
    margin-bottom: 35px;
}

.main-text h1 {
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 900;
    margin: 0;
    line-height: 1.05;
    letter-spacing: -0.02em;
}

.main-text h1.highlight {
    color: #ff7eb9;
}

.footer-section {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

    .next-circle-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: white;
        border: none;
        /* Centrare Flexbox */
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .arrow-icon {
        color: #d946ef;
        font-size: 28px; /* Dimensiune fixă mai mare */
        font-weight: 900;
        /* TRUC PENTRU CENTRARE: */
        /* Săgețile text tind să stea puțin "sus". Împingem cu 1-2px în jos manual */
        display: block;
        line-height: 1;
        margin-top: 2px;
        /* Grosime extra folosind text-stroke */
        -webkit-text-stroke: 1.5px #d946ef;
    }

    /* Efect de interacțiune */
    .next-circle-btn:active {
        transform: scale(0.92);
    }

.pagination-dots {
    display: flex;
    gap: 8px;
    align-items: center;
}

.dot {
    width: 14px;
    height: 2px;
    background: rgba(255,255,255,0.2);
}

.dot.active {
    width: 28px;
    background: #ff7eb9;
}

/* ===== MOBILE ===== */
@@media (max-width: 600px) {
    /* Imaginea ocupă tot ecranul, focalizată pe model */

        .onboarding-bg img {
            object-position: 65% center;
        }

    /* Sidebar devine un gradient de jos în sus, nu sidebar lateral */
        .glass-sidebar {
            width: 100% !important; /* Ocupă toată lățimea pe mobil */
            height: 100% !important;
            left: 0 !important;
            top: 0 !important;
            border-right: none !important;
            /* Gradientul: transparent sus, devine negru/blurat spre jos */
            background: linear-gradient( to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.2) 40%, rgba(0,0,0,0.8) 80%, rgba(0,0,0,0.9) 100% ) !important;
            /* Eliminăm blur-ul de pe tot ecranul ca să vedem modelul clar sus */
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            display: flex;
            align-items: flex-end; /* Împingem conținutul jos */
        }
    .onboarding-content {
        padding: 0 8% 12%;
        justify-content: flex-end;
        min-height: 55dvh; /* Suficient spațiu pentru text + buton */
    }

    .main-text h1 {
            font-size: clamp(24px, 5vw, 38px);
    }

    /* Buton mai mic și mai compact pe mobile */
        .next-circle-btn {
            width: 60px !important;
            height: 60px !important;
            order: 2; /* Butonul la dreapta */
        }
    .arrow-icon {
        font-size: 1.4rem;
    }

    /* SKIP mutat în stânga sus pe mobile pentru a nu acoperi modelul */
    .skip-btn-right {
        top: 20px;
        right: 20px;
        font-size: 10px;
    }

        .footer-section {
            flex-direction: row !important; /* Punem butonul și punctele pe același rând */
            align-items: center;
            justify-content: space-between;
            margin-top: 20px;
        }

        .pagination-dots {
            order: 1; /* Punctele la stânga */
        }
}
</style>