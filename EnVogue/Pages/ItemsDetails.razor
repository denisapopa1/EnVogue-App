@page "/item-details/{ItemId}"
@using EnVogue.Models
@using EnVogue.Services
@inject WardrobeServices WardrobeService
@inject NavigationManager Nav

<div class="page-container with-nav">
    @* HEADER CU BUTOANE DE ACȚIUNE - Adaptat designului tău *@
    <div class="top-detail-bar" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <button class="icon-button-top" @onclick='() => Nav.NavigateTo("/closet")'>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        </button>
        <h2 class="brand" style="font-size: 20px; margin: 0;">Item Details</h2>
        <div style="display: flex; gap: 10px;">
            @* Buton Edit *@
            <button class="icon-button-top" style="color: var(--info);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
            </button>
            @* Buton Delete - Corectat RZ9980 *@
            <button class="icon-button-top" style="color: var(--error);" @onclick="HandleDelete">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </button>
        </div>
    </div>

    @if (item != null)
    {
        <div class="center animate-fade-in" style="margin-bottom: 30px;">
            <img src="@item.ImageData" class="detail-main-img" style="width: 100%; max-width: 400px; border-radius: var(--radius-lg); box-shadow: var(--shadow-2); border: 1px solid var(--border-1);" />
        </div>

        @* Secțiune Informații - Stil Card Glass *@
        <div class="card card-glass animate-fade-in">
            <h3 style="font-size: 16px; margin-bottom: 20px; color: var(--accent);">👕 Basic Information</h3>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-1); padding-bottom: 12px;">
                    <span class="text-muted">Category</span>
                    <span style="font-weight: 600;">@item.Category • @item.Subcategory</span>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-1); padding-bottom: 12px;">
                    <span class="text-muted">Color</span>
                    <span style="font-weight: 600;">@item.Color</span>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-1); padding-bottom: 12px;">
                    <span class="text-muted">Season</span>
                    <span style="font-weight: 600;">@item.Season</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding-bottom: 4px;">
                    <span class="text-muted">Style</span>
                    <span style="font-weight: 600;">@(string.IsNullOrEmpty(item.Style) ? "N/A" : item.Style)</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string ItemId { get; set; } = "";
    private ClothingItem? item;

    protected override void OnInitialized()
    {
        item = WardrobeService.GetAllClothes().FirstOrDefault(i => i.Id == ItemId);
        if (item == null) Nav.NavigateTo("/closet");
    }

    private void HandleDelete()
    {
        WardrobeService.RemoveClothingItem(ItemId);
        Nav.NavigateTo("/closet");
    }
}