@code {
    [Parameter] public int ItemId { get; set; }
    private ClothingItem? item;
    private bool isEditing = false;
    private bool showDeleteConfirm = false;
    private bool showDiscardConfirm = false;


 

    private List<string> Seasons = new() { "Spring", "Summer", "Autumn", "Winter", "All Seasons" };
    private List<string> Styles = new() { "Casual Style", "Elegant Style", "Formal Wear", "Sporty Look" };
    private List<string> ColorOptions = new()
    {
        "Black", "White", "Gray", "Silver", "Beige", "Brown", "Navy",
        "Blue", "Red", "Green", "Pink", "Purple", "Gold"
    };

    private List<EnVogue.Models.Category> CategoriesFromDb = new();
    private List<EnVogue.Models.Subcategory> SubcategoriesFromDb = new();
    private readonly Dictionary<string, List<string>> SubcategoryFallbackMap = new()
    {
        { "Tops", new() { "T-shirt", "Blouse", "Hoodie", "Sweater" } },
        { "Bottoms", new() { "Jeans", "Trousers", "Skirt", "Shorts" } },
        { "Dress", new() { "Cocktail", "Maxi", "Mini", "Evening" } },
        { "Outerwear", new() { "Jacket", "Coat", "Blazer", "Cardigan" } },
        { "Shoes", new() { "Sneakers", "Boots", "Sandals", "Heels" } },
        { "Accessories", new() { "Scarf", "Belt", "Jewelry", "Hat" } }
    };
    private List<EnVogue.Models.Subcategory> FilteredSubcategories =>
        item?.CategoryId is int categoryId
            ? SubcategoriesFromDb.Where(s => s.CategoryId == categoryId).ToList()
            : new();

    private void SetItemColor(string selectedColor)
    {
        if (item == null) return;

        item.Color = selectedColor;
    }

    private string GetColorHex(string? colorName) => colorName switch
    {
        "Black" => "#1a1a1a",
        "White" => "#ffffff",
        "Gray" => "#808080",
        "Silver" => "#c0c0c0",
        "Beige" => "#f5f5dc",
        "Brown" => "#8b4513",
        "Navy" => "#000080",
        "Blue" => "#3b82f6",
        "Red" => "#ef4444",
        "Green" => "#22c55e",
        "Pink" => "#ec4899",
        "Purple" => "#a855f7",
        "Gold" => "#ffd700",
        _ => "#1a1a1a"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Încărcăm ambele liste
            CategoriesFromDb = await LoadCategoriesAsync();
            SubcategoriesFromDb = await LoadSubcategoriesAsync();
        }
        catch { /* Logica de eroare */ }

        await WardrobeService.InitializeAsync();
        LoadItemData();
    }
    private void LoadItemData()
    {
        var original = WardrobeService.GetAllClothes().FirstOrDefault(i => i.Id == ItemId);

        if (original != null)
        {
            // Creăm o instanță curată pentru această pagină
            item = new ClothingItem
            {
                Id = original.Id,
                Name = original.Name,
                Brand = original.Brand,
                CategoryId = original.CategoryId,
                CategoryName = original.CategoryName,
                SubcategoryId = original.SubcategoryId,
                SubcategoryName = original.SubcategoryName,
                Season = original.Season,
                Style = original.Style,
                Color = original.Color,
                ImagePath = original.ImagePath
            };

            // Validare de siguranță pentru categoriile venite din DB
            if (string.IsNullOrEmpty(item.CategoryName)) item.CategoryName = "Tops";

            if (!item.CategoryId.HasValue && !string.IsNullOrWhiteSpace(item.CategoryName))
            {
                item.CategoryId = CategoriesFromDb.FirstOrDefault(c => c.Name == item.CategoryName)?.Id;
            }

            if (!item.SubcategoryId.HasValue && item.CategoryId.HasValue && !string.IsNullOrWhiteSpace(item.SubcategoryName))
            {
                item.SubcategoryId = SubcategoriesFromDb
                    .FirstOrDefault(s => s.CategoryId == item.CategoryId.Value && s.Name == item.SubcategoryName)?.Id;
            }

            UpdateSubcategories();
            StateHasChanged();
        }
    }

    private void UpdateSubcategories()
    {
        if (item == null) return;

        if (!item.CategoryId.HasValue && !string.IsNullOrWhiteSpace(item.CategoryName))
        {
            item.CategoryId = CategoriesFromDb.FirstOrDefault(c => c.Name == item.CategoryName)?.Id;
        }

        if (item.CategoryId.HasValue)
        {
            item.CategoryName = CategoriesFromDb.FirstOrDefault(c => c.Id == item.CategoryId.Value)?.Name ?? item.CategoryName;
        }

        // Dacă subcategoria actuală a hainei nu se află în lista categoriei curente, o resetăm pe prima
        if (!FilteredSubcategories.Any(s => s.Id == item.SubcategoryId))
        {
            item.SubcategoryId = FilteredSubcategories.FirstOrDefault()?.Id;
        }

        if (item.SubcategoryId.HasValue)
        {
            item.SubcategoryName = FilteredSubcategories.FirstOrDefault(s => s.Id == item.SubcategoryId.Value)?.Name ?? item.SubcategoryName;
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (item == null)
        {
            return;
        }

        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            item.CategoryId = id;

            item.CategoryName = CategoriesFromDb.FirstOrDefault(c => c.Id == id)?.Name;

            UpdateSubcategories();
            StateHasChanged();
        }
    }

    private async Task<List<EnVogue.Models.Category>> LoadCategoriesAsync()
    {
        var categories = await TryGetJsonAsync<List<EnVogue.Models.Category>>("api/clothing/categories")
            ?? await TryGetJsonAsync<List<EnVogue.Models.Category>>("api/categories");

        if (categories != null && categories.Any())
        {
            return categories;
        }

        return new List<EnVogue.Models.Category>
        {
            new() { Id = 1, Name = "Tops" },
            new() { Id = 2, Name = "Bottoms" },
            new() { Id = 3, Name = "Dress" },
            new() { Id = 4, Name = "Outerwear" },
            new() { Id = 5, Name = "Shoes" },
            new() { Id = 6, Name = "Accessories" }
        };
    }

    private async Task<List<EnVogue.Models.Subcategory>> LoadSubcategoriesAsync()
    {
        var subcategories = await TryGetJsonAsync<List<EnVogue.Models.Subcategory>>("api/clothing/subcategories")
            ?? await TryGetJsonAsync<List<EnVogue.Models.Subcategory>>("api/subcategories");

        if (subcategories != null && subcategories.Any())
        {
            return subcategories;
        }

        var fallbackCategories = CategoriesFromDb.Any()
            ? CategoriesFromDb
            : new List<EnVogue.Models.Category>
            {
                new() { Id = 1, Name = "Tops" },
                new() { Id = 2, Name = "Bottoms" },
                new() { Id = 3, Name = "Dress" },
                new() { Id = 4, Name = "Outerwear" },
                new() { Id = 5, Name = "Shoes" },
                new() { Id = 6, Name = "Accessories" }
            };

        var fallbackSubcategories = new List<EnVogue.Models.Subcategory>();
        var nextId = 1;

        foreach (var category in fallbackCategories)
        {
            if (!SubcategoryFallbackMap.TryGetValue(category.Name, out var names))
            {
                continue;
            }

            foreach (var name in names)
            {
                fallbackSubcategories.Add(new EnVogue.Models.Subcategory
                {
                    Id = nextId++,
                    Name = name,
                    CategoryId = category.Id
                });
            }
        }

        return fallbackSubcategories;
    }

    private async Task<T?> TryGetJsonAsync<T>(string uri)
    {
        try
        {
            return await Client.GetFromJsonAsync<T>(uri);
        }
        catch
        {
            return default;
        }
    }

    private void OnSubcategoryChanged(ChangeEventArgs e)
    {
        if (item == null) return;

        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            item.SubcategoryId = id;
            item.SubcategoryName = FilteredSubcategories.FirstOrDefault(s => s.Id == id)?.Name ?? item.SubcategoryName;
            StateHasChanged();
        }
    }

    private string GetImageSource(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath)) return "Images/placeholder.png";
        var fileName = System.IO.Path.GetFileName(imagePath);
        return ApiEndpoints.ImageUrl(fileName);
    }
    private async Task SaveChanges()
    {
        if (item == null) return;

        var original = WardrobeService.GetAllClothes().FirstOrDefault(i => i.Id == ItemId);

        if (original != null)
        {
            bool hasChanges = original.Brand != item.Brand ||
                              original.CategoryId != item.CategoryId ||
                              original.SubcategoryId != item.SubcategoryId ||
                              original.CategoryName != item.CategoryName ||
                              original.SubcategoryName != item.SubcategoryName ||
                              original.Style != item.Style ||
                              original.Color != item.Color;

            if (hasChanges)
            {
                await WardrobeService.UpdateClothingItem(item);
                await WardrobeService.InitializeAsync(forceReload: true);

                Toast.Show("Updated!", "success");
            }
        }

        isEditing = false;
        StateHasChanged();
    }
    private void CancelEdit() { isEditing = false; LoadItemData(); }
    private void HandleDelete() => showDeleteConfirm = true;
    private async Task ConfirmDelete()
    {
        await WardrobeService.RemoveClothingItem(ItemId);
        Nav.NavigateTo("/closet");
    }
    private void ConfirmDiscard() { showDiscardConfirm = false; isEditing = false; LoadItemData(); }
}
