@page "/create-outfit"
@using EnVogue.Models
@using EnVogue.Services

<div class="page-content with-nav">
    <div class="profile-header">
        <h2>Create Outfit</h2>
    </div>

    @if (generatedOutfit == null)
    {
        <p class="page-subtitle center" style="margin-bottom: 24px;">Choose how you want to create your outfit:</p>

        <div class="toggle-switch">
            <button class="toggle-option @(isManual ? "active" : "")" @onclick="() => isManual = true">Manual</button>
            <button class="toggle-option @(!isManual ? "active" : "")" @onclick="() => isManual = false">Automatic</button>
        </div>

        @if (isManual)
        {
            <div class="card animate-fade-in form-limit">
                <h3 class="center" style="margin-bottom: 12px;">Select Items Manually</h3>
                <p class="text-muted center" style="margin-bottom: 20px;">Choose items from your closet to create your outfit</p>

                <div class="center">
                    <button class="fab" @onclick='() => NavigationManager.NavigateTo("/closet")'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                    <p class="page-subtitle" style="margin-top: 12px;">Browse your closet</p>
                </div>
            </div>
        }
        else
        {
            <div class="card animate-fade-in form-limit">
                <h3 class="center" style="margin-bottom: 12px;">Automatic Generation</h3>
                <p class="text-muted center" style="margin-bottom: 20px;">Generate outfits based on smart matching rules</p>

                <div class="input-group">
                    <label>Occasion (optional)</label>
                    <input type="text" class="input-field" placeholder="E.g., Casual, Office, Party" @bind="occasion" />
                </div>

                <div class="input-group">
                    <label>Preferred Colors (optional)</label>
                    <input type="text" class="input-field" placeholder="E.g., Blue, Black, White" @bind="colors" />
                </div>

                <button class="btn-primary" @onclick="GenerateOutfit" disabled="@isGenerating">
                    @(isGenerating ? "Generating..." : "Generate Outfit")
                </button>
            </div>
        }
    }
    else
    {
        <div class="card animate-fade-in form-limit">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3>Your Outfit</h3>
                <button class="btn-secondary" @onclick="() => generatedOutfit = null">Reset</button>
            </div>

            @if (generatedOutfit.Items.Any())
            {
                <div class="outfit-grid">
                    @foreach (var item in generatedOutfit.Items)
                    {
                        <div><img src="@item.ImageData" alt="@item.Name" /></div>
                    }
                </div>

                <div style="display: flex; gap: 12px;">
                    <button class="btn-secondary" style="flex: 1;" @onclick="SaveToFavorites">❤️ Save to Favorites</button>
                    <button class="btn-primary" style="flex: 1;" @onclick="GenerateOutfit">Generate New</button>
                </div>
            }
            else
            {
                <p class="center text-muted">Not enough items to generate an outfit.</p>
                <button class="btn-primary" @onclick='() => NavigationManager.NavigateTo("/add-item")'>Add Items</button>
            }
        </div>
    }
</div>

<NavBar CurrentPage="create" />

@code {
    private bool isManual = false;
    private string occasion = "";
    private string colors = "";
    private bool isGenerating = false;
    private Outfit? generatedOutfit = null;

    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    [Inject] WardrobeServices WardrobeService { get; set; } = default!;

    private async Task GenerateOutfit()
    {
        isGenerating = true;
        await Task.Delay(500);

        generatedOutfit = WardrobeService.GenerateOutfitWithRules(occasion, colors);

        isGenerating = false;
    }

    private void SaveToFavorites()
    {
        if (generatedOutfit != null)
        {
            generatedOutfit.IsFavorite = true;
            WardrobeService.AddOutfit(generatedOutfit);
            NavigationManager.NavigateTo("/favorites");
        }
    }
}