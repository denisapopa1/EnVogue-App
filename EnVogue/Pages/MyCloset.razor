@page "/closet"
@using EnVogue.Models
@using EnVogue.Services
@inject NavigationManager NavigationManager
@inject WardrobeServices WardrobeService
@implements IDisposable

<div class="page-container with-nav">
    @* --- HEADER ȘI STATISTICI --- *@
    <div class="profile-header" style="margin-bottom: 25px;">
        <h2 style="font-size: 24px; font-weight: 800; margin-bottom: 5px;">My Wardrobe</h2>

        @if (AllItems.Any())
        {
            <div class="stats-badge animate-fade-in" style="display: inline-flex; align-items: center; background: rgba(255,255,255,0.1); padding: 5px 15px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1);">
                <span style="font-size: 13px; font-weight: 600; opacity: 0.9;">
                    <span style="margin-right: 5px;">📦</span> Total: @AllItems.Count items
                </span>
            </div>
        }
    </div>

    @if (AllItems.Any())
    {
        @* --- BARA DE CĂUTARE ȘI FILTRE --- *@
        <div class="search-container-modern" style="margin-bottom: 12px;">
            <div class="search-input-wrapper">
                <svg class="search-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="input-field-modern" placeholder="Search by brand, style, color..."
                       @bind-value="Filter.SearchTerm" @bind-value:event="oninput" @onkeyup="ApplyFilters" />
            </div>
        </div>

        <div class="action-bar-pills">
            <button class="action-pill @(isFilterOpen ? "active" : "")" @onclick="ToggleFilter">
                <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                <span>Filters</span>
                <span class="chevron">@(isFilterOpen ? "▲" : "▼")</span>
            </button>

            <button class="action-pill @(isSortOpen ? "active" : "")" @onclick="ToggleSort">
                <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>Sort</span>
                <span class="chevron">@(isSortOpen ? "▲" : "▼")</span>
            </button>

            @if (Filter.SelectedCategory != "All" || Filter.SelectedSeason != "All" || Filter.Style != "All" || !string.IsNullOrEmpty(Filter.Color))
            {
                <button class="reset-link" @onclick="ResetFilters">Reset</button>
            }
        </div>

        @* --- PANOURI FILTRARE --- *@
        <div class="expandable-panels">
            @if (isFilterOpen)
            {
                <div class="filter-panel-content animate-slide-down card-glass">
                    <div class="filter-section">
                        <p class="panel-label">Category</p>
                        <div class="pills-grid">
                            <button class="pill-btn @(Filter.SelectedCategory == "All" ? "active" : "")" @onclick='() => SetCategory("All")'>All</button>
                            @foreach (var cat in AllCategories)
                            {
                                <button class="pill-btn @(Filter.SelectedCategory == cat ? "active" : "")" @onclick='() => SetCategory(cat)'>@cat</button>
                            }
                        </div>
                    </div>

                    <div class="filter-section" style="margin-top: 20px;">
                        <p class="panel-label">Color Palette</p>
                        <div class="color-options-grid" style="display: flex; flex-wrap: wrap; gap: 10px;">
                            <div class="color-item @(string.IsNullOrEmpty(Filter.Color) ? "active" : "")" @onclick='() => SetColor("")' style="cursor:pointer; text-align:center;">
                                <div class="color-circle" style="width:34px; height:34px; border-radius:50%; border:2px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center;">🌈</div>
                                <span style="font-size:10px; color:white; display:block; margin-top:4px;">All</span>
                            </div>
                            @foreach (var color in PopularColors)
                            {
                                <div class="color-item @(Filter.Color == color ? "active" : "")" @onclick='() => SetColor(color)' style="cursor:pointer; text-align:center;">
                                    <div class="color-circle shadow-sm" style="width:34px; height:34px; border-radius:50%; border:2px solid rgba(255,255,255,0.15); background-color:@(GetColorHex(color))"></div>
                                    <span style="font-size:10px; color:white; display:block; margin-top:4px;">@color</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (isSortOpen)
            {
                <div class="filter-panel-content animate-slide-down card-glass">
                    <p class="panel-label">Sort Order</p>
                    <div class="pills-grid">
                        <button class="pill-btn @(Filter.SortBy == "Newest" ? "active" : "")" @onclick='() => SetSort("Newest")'>Newest First</button>
                        <button class="pill-btn @(Filter.SortBy == "Oldest" ? "active" : "")" @onclick='() => SetSort("Oldest")'>Oldest First</button>
                        <button class="pill-btn @(Filter.SortBy == "Brand" ? "active" : "")" @onclick='() => SetSort("Brand")'>By Brand</button>
                    </div>
                </div>
            }
        </div>
    }

    @* --- AFISARE CONTINUT --- *@
    @if (isLoading)
    {
        <div class="outfit-grid" style="margin-top: 20px;">
            @for (int i = 0; i < 6; i++)
            {
                <div class="skeleton-card card-glass">
                    <div class="skeleton skeleton-img" style="height:220px; border-radius:12px; margin-bottom:12px;"></div>
                    <div class="skeleton skeleton-text" style="width: 70%; height:16px; margin-bottom:6px;"></div>
                    <div class="skeleton skeleton-text" style="width: 45%; height:14px;"></div>
                </div>
            }
        </div>
    }
    else if (!AllItems.Any())
    {
        <div class="card card-glass center" style="padding: 80px 40px; margin-top: 40px; text-align:center;">
            <div style="margin-bottom: 30px; opacity: 0.5;">
                <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <path d="M22 19V9a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2zM6 7V5a2 2 0 012-2h8a2 2 0 012 2v2" />
                </svg>
            </div>
            <h2 style="font-weight: 700; margin-bottom: 15px; font-size: 22px;">Your closet is empty</h2>
            <p style="opacity:0.6; margin-bottom:30px;">Start building your digital wardrobe by adding items.</p>
            <button class="btn-primary" @onclick='() => NavigationManager.NavigateTo("/add-item")' style="width: auto; padding: 15px 40px;">+ Add Your First Item</button>
        </div>
    }
    else if (!FilteredItems.Any())
    {
        <div class="card card-glass center animate-fade-in" style="padding: 80px 40px; margin-top: 40px; text-align:center; border: 1px dashed rgba(255,255,255,0.2);">
            <div style="font-size: 60px; margin-bottom: 25px;">🔍</div>
            <h2 style="font-weight: 700; font-size: 22px;">No matches found</h2>
            <p style="opacity:0.6; margin-bottom:30px;">Try adjusting your filters or search terms.</p>
            <button class="btn-primary" @onclick="ResetFilters" style="width: auto; padding: 15px 40px; background: rgba(255,255,255,0.1);">Clear All Filters</button>
        </div>
    }
    else
    {
        <div class="outfit-grid" style="margin-top: 20px;">
            @foreach (var item in FilteredItems)
            {
                <div class="wardrobe-card animate-fade-in" @onclick='() => NavigationManager.NavigateTo($"/item-details/{item.Id}")'>
                    <div class="card-image-container">
                        <img src="@item.ImageData" style="width:100%; border-radius:12px 12px 0 0; display:block;" />
                    </div>

                    @* REPARARE DESIGN: Text negru pe fundal alb, box mai mare *@
                    <div class="card-content" style="background: white; padding: 15px; border-radius: 0 0 12px 12px; text-align: center;">
                        <h3 style="font-weight: 700; font-size: 16px; margin: 0; color: #1a1a1a;">
                            @(string.IsNullOrWhiteSpace(item.Brand) ? item.Subcategory : item.Brand)
                        </h3>
                        <p style="font-size: 13px; color: #666; margin: 5px 0 0 0; opacity: 1;">
                            @item.Subcategory • @item.Color
                        </p>
                    </div>
                </div>
            }
        </div>
    }
</div>

<NavBar CurrentPage="my-closet" />

<style>
    .skeleton {
        background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
        border-radius: 8px;
    }

    @@keyframes skeleton-loading {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

    .skeleton-card {
        padding: 15px;
        border-radius: 20px;
        margin-bottom: 20px;
    }
</style>

@code {
    private FilterModel Filter = new FilterModel { SelectedCategory = "All", SelectedSeason = "All", Style = "All", SortBy = "Newest", Subcategory = "" };
    private List<ClothingItem> AllItems = new List<ClothingItem>();
    private List<ClothingItem> FilteredItems = new List<ClothingItem>();
    private List<string> AllCategories = new() { "Tops", "Bottoms", "Dress", "Outerwear", "Shoes", "Accessories" };
    private List<string> PopularColors = new() { "Black", "White", "Gray", "Silver", "Beige", "Brown", "Navy", "Blue", "Red", "Green", "Pink", "Purple", "Gold" };
    private List<string> AvailableSubcategories = new List<string>();
    private bool isLoading = true;
    private bool isFilterOpen = false;
    private bool isSortOpen = false;

    private Dictionary<string, List<string>> SubcategoryMap = new() {
        { "Tops", new() { "T-shirt", "Blouse", "Sweater", "Hoodie" } },
        { "Bottoms", new() { "Jeans", "Trousers", "Skirt", "Shorts" } },
        { "Dress", new() { "Mini", "Maxi", "Cocktail", "Evening" } },
        { "Outerwear", new() { "Jacket", "Coat", "Blazer", "Vest"} },
        { "Shoes", new() { "Sneakers", "Boots", "Heels", "Sandals"} },
        { "Accessories", new() { "Scarf", "Belt", "Jewelry", "Hat" } }
    };
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        // Încarcă datele inițiale
        await RefreshData();

        // Înregistrează evenimentul folosind o funcție anonimă compatibilă cu Action
        WardrobeService.OnChange += HandleOnChange;

        await Task.Delay(600);
        isLoading = false;
    }

    // Creăm o metodă de tip "void" specială pentru eveniment
    private void HandleOnChange() => InvokeAsync(async () => await RefreshData());

    private async Task RefreshData()
    {
        // Obținem hainele din lista deja încărcată în serviciu
        AllItems = WardrobeService.GetAllClothes();
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleFilter() { isFilterOpen = !isFilterOpen; isSortOpen = false; }
    private void ToggleSort() { isSortOpen = !isSortOpen; isFilterOpen = false; }
    private void SetCategory(string cat) { Filter.SelectedCategory = cat; Filter.Subcategory = ""; UpdateSubcategories(); ApplyFilters(); }
    private void SetColor(string color) { Filter.Color = color; ApplyFilters(); }
    private void SetSort(string sort) { Filter.SortBy = sort; ApplyFilters(); }
    private void ResetFilters() { Filter = new FilterModel { SelectedCategory = "All", SelectedSeason = "All", Style = "All", SortBy = "Newest" }; UpdateSubcategories(); ApplyFilters(); }

    private void UpdateSubcategories()
    {
        if (SubcategoryMap.ContainsKey(Filter.SelectedCategory)) AvailableSubcategories = SubcategoryMap[Filter.SelectedCategory];
        else AvailableSubcategories = new List<string>();
    }

    private string GetColorHex(string colorName)
    {
        return colorName.ToLower() switch
        {
            "black" => "#1a1a1a",
            "white" => "#ffffff",
            "gray" => "#808080",
            "silver" => "#c0c0c0",
            "beige" => "#f5f5dc",
            "brown" => "#8b4513",
            "navy" => "#000080",
            "blue" => "#3b82f6",
            "red" => "#ef4444",
            "green" => "#22c55e",
            "pink" => "#ec4899",
            "purple" => "#a855f7",
            "gold" => "#ffd700",
            _ => "#808080"
        };
    }

    private void ApplyFilters()
    {
        var query = AllItems.AsQueryable();
        var search = Filter.SearchTerm?.Trim().ToLower() ?? "";
        if (!string.IsNullOrEmpty(search))
        {
            var searchTerms = search.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            foreach (var term in searchTerms)
            {
                query = query.Where(i =>
                    (i.Brand != null && i.Brand.ToLower().Contains(term)) ||
                    (i.Category != null && i.Category.ToLower().Contains(term)) ||
                    (i.Subcategory != null && i.Subcategory.ToLower().Contains(term)) ||
                    (i.Color != null && i.Color.ToLower().Contains(term)));
            }
        }
        if (Filter.SelectedCategory != "All") query = query.Where(i => i.Category == Filter.SelectedCategory);
        if (!string.IsNullOrEmpty(Filter.Color)) query = query.Where(i => i.Color.Contains(Filter.Color, StringComparison.OrdinalIgnoreCase));
        FilteredItems = query.ToList();
        StateHasChanged();
    }
    public void Dispose() => WardrobeService.OnChange -= HandleOnChange;
}