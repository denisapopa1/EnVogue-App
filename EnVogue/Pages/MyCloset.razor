        var newOutfit = new Outfit
        {
            Name = NormalizedOutfitName,
            Items = new List<ClothingItem>(SelectedItems),
            Occasion = outfitStyle,
            CreatedDate = DateTime.Now,
            CreationSource = "Manual"
        };
        var saveResult = await WardrobeService.AddOutfit(newOutfit);
        if (!saveResult.Success)
        {
            Toast.Show(saveResult.Message, "error");
            return;
        }

        Toast.Show(saveResult.Message, "success");
        NavigationManager.NavigateTo("/my-outfits");
    }

    private Dictionary<string, List<string>> SubcategoryMap = new() {
        { "Tops", new() { "T-shirt", "Blouse", "Sweater", "Hoodie" } },
        { "Bottoms", new() { "Jeans", "Trousers", "Skirt", "Shorts" } },
        { "Dress", new() { "Mini", "Maxi", "Cocktail", "Evening" } },
        { "Outerwear", new() { "Jacket", "Coat", "Blazer", "Vest"} },
        { "Shoes", new() { "Sneakers", "Boots", "Heels", "Sandals"} },
        { "Accessories", new() { "Scarf", "Belt", "Jewelry", "Hat" } }
    };
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await RefreshData();
        DraftFilter = CloneFilter(Filter);
        UpdateSubcategories(Filter);
        WardrobeService.OnChange += HandleOnChange;

        // --- LOGICA PENTRU AFIȘARE MESAJ ȘI CURĂȚARE URL ---
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (uri.Query.Contains("success=true"))
        {
            ShowToast("✨ Item added to your collection!");

            // CURĂȚĂM URL-UL: Înlocuim adresa cu varianta fără parametri
            // 'false' înseamnă că nu reîncărcăm pagina, doar schimbăm textul din bara de sus
            NavigationManager.NavigateTo("/closet", forceLoad: false, replace: true);
        }

        await Task.Delay(800);
        isLoading = false;
    }

    // Această metodă va fi apelată DOAR dacă se schimbă datele în timp ce ești pe pagină
    private void HandleOnChange() => InvokeAsync(async () =>
    {
        await RefreshData();
        ShowToast("Garderobă actualizată!");
    });

    // FUNCȚIA UNICĂ pentru afișarea mesajului
    private void ShowToast(string message)
    {
        localSuccessMessage = message;
        StateHasChanged();

        // Folosim un ID de sesiune simplu sau anulăm task-ul precedent dacă vrei complexitate,
        // dar pentru acest caz e suficient să curățăm după X secunde:
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            localSuccessMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }


    private async Task RefreshData()
    {
        await WardrobeService.InitializeAsync();
        AllItems = WardrobeService.GetAllClothes();

        // În loc de FilteredItems = AllItems, aplicăm filtrele curente
        // pentru a păstra selecția utilizatorului (ex: dacă era pe categoria 'Tops')
        Console.WriteLine($"Closet: Am găsit {AllItems.Count} haine în DB.");
        ApplyFilters();
        StateHasChanged();
    }
