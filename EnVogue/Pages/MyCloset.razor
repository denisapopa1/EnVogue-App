    private void UpdateSubcategories(FilterModel source) { AvailableSubcategories = SubcategoryMap.ContainsKey(source.SelectedCategory) ? SubcategoryMap[source.SelectedCategory] : new(); }
    private void SetSubcategory(string sub) { DraftFilter.Subcategory = sub; }
    private void SetColor(string color) { DraftFilter.Color = color; }
    private void SetSeason(string season) { DraftFilter.SelectedSeason = season; }
    private void SetStyle(string style) { DraftFilter.Style = style; }
    private void SetSort(string sort)
