    private const int MinOutfitNameLength = 6;
    [Parameter] public string? Mode { get; set; } // "select" sau null
    private bool IsSelectionMode => Mode == "select";

    private List<ClothingItem> SelectedItems = new();
    private string outfitName = "";
    private string outfitStyle = "Casual Style";
    private readonly List<string> OutfitStyleOptions = new()
    {
        "Casual Style",
        "Formal Wear",
        "Elegant Style",
        "Sporty Look"
    };
    private string NormalizedOutfitName => outfitName.Trim();
    private bool IsOutfitNameValid => NormalizedOutfitName.Length >= MinOutfitNameLength;
    private bool CanSaveOutfit => SelectedItems.Any() && IsOutfitNameValid;
    private string GetOutfitNameInputClass() => !string.IsNullOrWhiteSpace(outfitName) && !IsOutfitNameValid
        ? "input-invalid"
        : string.Empty;
    private void HandleItemClick(ClothingItem item)
    {
        if (IsSelectionMode)
        {
            // Suntem în Studio/Manual Mode: Doar selectăm/deselectăm haina
            ToggleSelection(item);
        }
        else
        {
            // Suntem în modul normal Closet: Mergem la pagina de detalii
            NavigationManager.NavigateTo($"/item-details/{item.Id}");
        }
    }

    private void ToggleSelection(ClothingItem item)
    {
        // Verificăm după ID dacă există deja
        var existing = SelectedItems.FirstOrDefault(i => i.Id == item.Id);

        if (existing != null)
        {
            // Dacă există, o scoatem (click-ul numărul 2)
            SelectedItems.Remove(existing);
        }
        else
        {
            // Dacă nu există, o adăugăm (click-ul numărul 1)
            SelectedItems.Add(item);
        }

        StateHasChanged();
    }
