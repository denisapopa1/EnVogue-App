    }

    // Această metodă va fi apelată DOAR dacă se schimbă datele în timp ce ești pe pagină
    private void HandleOnChange() => InvokeAsync(async () =>
    {
        await RefreshData();
        ShowToast("Garderobă actualizată!");
    });

    // FUNCȚIA UNICĂ pentru afișarea mesajului
    private void ShowToast(string message)
    {
        localSuccessMessage = message;
        StateHasChanged();

        // Folosim un ID de sesiune simplu sau anulăm task-ul precedent dacă vrei complexitate,
        // dar pentru acest caz e suficient să curățăm după X secunde:
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            localSuccessMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }


    private async Task RefreshData()
    {
        await WardrobeService.InitializeAsync();
        AllItems = WardrobeService.GetAllClothes();

        // În loc de FilteredItems = AllItems, aplicăm filtrele curente
        // pentru a păstra selecția utilizatorului (ex: dacă era pe categoria 'Tops')
        Console.WriteLine($"Closet: Am găsit {AllItems.Count} haine în DB.");
        ApplyFilters();
        StateHasChanged();
    }
    private void SetCategory(string cat) { Filter.SelectedCategory = cat; Filter.Subcategory = ""; UpdateSubcategories(); ApplyFilters(); }
    private void UpdateSubcategories() { AvailableSubcategories = SubcategoryMap.ContainsKey(Filter.SelectedCategory) ? SubcategoryMap[Filter.SelectedCategory] : new(); }
    private void SetSubcategory(string sub) { Filter.Subcategory = sub; ApplyFilters(); }
    private void SetColor(string color) { Filter.Color = color; ApplyFilters(); }
    private void SetSeason(string season) { Filter.SelectedSeason = season; ApplyFilters(); }
    private void SetStyle(string style) { Filter.Style = style; ApplyFilters(); }
    private void SetSort(string sort)
    {
        Filter.SortBy = sort;
        // Am eliminat ApplyFilters() de aici
    }
    private void ResetFilters()
    {
        Filter = new FilterModel
        {
            SelectedCategory = "All",
            SelectedSeason = "All",
            Color = "",
            Subcategory = "",
            SearchTerm = "",
            SortBy = "Newest" // Resetăm și ordinea
        };

        UpdateSubcategories();
        ApplyFilters();
        ClosePanels();
    }
