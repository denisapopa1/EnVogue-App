@page "/closet"
@page "/closet/{Mode}" 
@using EnVogue.Models
@using EnVogue.Services
@inject NavigationManager NavigationManager
@inject WardrobeServices WardrobeService
@implements IDisposable
@layout EmptyLayout
@inject EnVogue.Services.NotificationService Toast

<div class="closet-page-wrapper">
    @if (isFilterOpen || isSortOpen)
    {
        <div class="panels-overlay" @onclick="ClosePanels"></div>
    }
    <div class="content-overlay @(IsSelectionMode ? "selection-scroll" : "")">

        <div class="editorial-header">
            <div class="header-left">
    <div class="brand-nav-group" style="display: flex; align-items: flex-start; gap: 15px;">
        @* Butonul Săgeată (Back) adăugat pentru uniformitate *@
        <BackCircleButton FallbackRoute="/home" />

        @* Containerul nou care pune textul tău pe verticală *@
        <div class="brand-text-wrapper" style="display: flex; flex-direction: column; align-items: flex-start;">
            <h1 class="brand-title" tabindex="-1">EnVogue</h1>
            <span class="collection-tag">MY COLLECTION</span>
        </div>
    </div>
</div>
            <div class="header-right" style="position: relative;">
                <div class="header-actions">
                    <div class="profile-action">
                        <ProfileAvatarButton />
                    </div>

                    <button class="profile-circle fav-circle"
                            @onclick='() => NavigationManager.NavigateTo("/favorites")'
                            aria-label="Favorites">
                        <svg viewBox="0 0 24 24">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        @* ========================================== *@
        @* NOU: PANOU SELECȚIE OUTFIT (Apare doar în mod select) *@
        @* ========================================== *@
        @if (IsSelectionMode)
        {
            <div class="selection-card-container animate-slide-down">
                <div class="selection-header-row">
                    <h2 class="selection-title">Your Selection</h2>
                    <span class="items-count-badge">@SelectedItems.Count ITEMS</span>
                </div>

                @* ZONA DE PREVIEW IMAGINI *@
                <div class="canvas-preview-dashed">
                    @if (!SelectedItems.Any())
                    {
                        <div class="empty-selection-placeholder">
                            <span class="plus-mini">+</span>
                            <p>SELECT BELOW</p>
                        </div>
                    }
                    else
                    {
                        <div class="selected-images-scroll">
                            @foreach (var item in SelectedItems)
                            {
                                <div class="mini-thumbnail animate-pop" @onclick="() => ToggleSelection(item)">
                                    <img src="@GetImageSource(item.ImagePath)" />

                                    @* Acest div va apărea la hover (din CSS) *@
                                    <div class="remove-overlay">
                                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="white" stroke-width="3" fill="none">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
        
                @* INPUT ȘI BUTON *@
                <div class="selection-footer-controls">
                    <div class="outfit-name-field">
                        <input type="text"
                               placeholder="Outfit Name (e.g. Summer Brunch)"
                               @bind="outfitName"
                               @bind:event="oninput"
                               minlength="@MinOutfitNameLength"
                               aria-invalid="@(!IsOutfitNameValid && !string.IsNullOrWhiteSpace(outfitName))"
                               class="outfit-name-input-styled @GetOutfitNameInputClass()" />

                        @if (!string.IsNullOrWhiteSpace(outfitName) && !IsOutfitNameValid)
                        {
                            <span class="outfit-name-validation-message">
                                Outfit name must have at least @MinOutfitNameLength characters.
                            </span>
                        }
                    </div>

                    <select @bind="outfitStyle" class="outfit-style-select-styled">
                        @foreach (var styleOption in OutfitStyleOptions)
                        {
                            <option value="@styleOption">@styleOption</option>
                        }
                    </select>

                    @* Butonul de salvare (se va colora singur datorită clasei condiționate) *@
                    <button class="save-outfit-btn-styled @(CanSaveOutfit ? "btn-ready" : "btn-disabled")"
                            @onclick="HandleSaveOutfitClick">
                        SAVE OUTFIT
                    </button>
                </div>
            </div>
        }
        <div class="closet-results-scroll">
        @if (AllItems != null && AllItems.Any())
        {
            <div class="closet-top-stats">
                <div class="stats-badge-editorial closet-stats-badge">
                    <span>📦 TOTAL: @AllItems.Count ITEMS</span>
                </div>
            </div>
        }
        <div class="search-bar-editorial">
            <div class="search-input-wrapper">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>

                <input type="text" placeholder="Search by brand, style, color..."
                       value="@Filter.SearchTerm"
                       @oninput="HandleInstantSearch"
                       @onkeydown="HandleSearchEnter"
                       @onclick="ClosePanels" /> @* ACUM ESTE CORECT *@

                <button class="search-confirm-btn" @onclick="HandleSearchConfirm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>
            </div>
        </div>
        <div class="editorial-controls">
            <div class="control-row">
                <button class="filter-sort-btn @(isFilterOpen ? "active" : "")" @onclick="ToggleFilter">
                    <svg class="control-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" /></svg>
                    <span>Filters</span> <span class="chevron">@(isFilterOpen ? "▲" : "▼")</span>
                </button>
                <button class="filter-sort-btn @(isSortOpen ? "active" : "")" @onclick="ToggleSort">
                    <svg class="control-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5M7 14l5 5 5-5" /></svg>
                    <span>Sort</span> <span class="chevron">@(isSortOpen ? "▲" : "▼")</span>
                </button>
                @if (Filter.SelectedCategory != "All" || !string.IsNullOrEmpty(Filter.Color))
                {
                    <button class="reset-link-editorial" @onclick="ResetFilters">Reset</button>
                }
            </div>

            <div class="expandable-panels">
                @if (isFilterOpen)
                {
                    @* Panoul de filtre ocupă partea stângă *@
                    <div class="editorial-panel filter-panel animate-slide-down">
                        <p class="panel-label">CATEGORY</p>
                        <div class="pills-grid">
                            <button class="pill-btn @(DraftFilter.SelectedCategory == "All" ? "active" : "")" @onclick='() => SetCategory("All")'>All</button>
                            @foreach (var cat in AllCategories)
                            {
                                <button class="pill-btn @(DraftFilter.SelectedCategory == cat ? "active" : "")" @onclick='() => SetCategory(cat)'>@cat</button>
                            }
                        </div>

                        @if (DraftFilter.SelectedCategory != "All" && AvailableSubcategories.Any())
                        {
                            <p class="panel-label" style="margin-top: 20px;">SUBCATEGORY</p>
                            <div class="pills-grid">
                                <button class="pill-btn @(string.IsNullOrEmpty(DraftFilter.Subcategory) ? "active" : "")" @onclick='() => SetSubcategory("")'>Any</button>
                                @foreach (var sub in AvailableSubcategories)
                                {
                                    <button class="pill-btn @(DraftFilter.Subcategory == sub ? "active" : "")" @onclick='() => SetSubcategory(sub)'>@sub</button>
                                }
                            </div>
                        }

                        <p class="panel-label" style="margin-top: 20px;">SEASON</p>
                        <div class="pills-grid">
                            <button class="pill-btn @(DraftFilter.SelectedSeason == "All" ? "active" : "")" @onclick='() => SetSeason("All")'>All</button>
                            @foreach (var season in new[] { "Summer", "Winter", "Spring", "Autumn" })
                            {
                                <button class="pill-btn @(DraftFilter.SelectedSeason == season ? "active" : "")" @onclick='() => SetSeason(season)'>@season</button>
                            }
                        </div>

                        <p class="panel-label" style="margin-top: 20px;">COLOR PALETTE</p>
                        <div class="color-options-grid">
                            @foreach (var color in PopularColors)
                            {
                                <div class="color-item @(DraftFilter.Color == color ? "active" : "")" @onclick='() => SetColor(color)'>
                                    <div class="color-circle" style="background-color:@(GetColorHex(color));"></div>
                                </div>
                            }

                        </div>
                        <div class="panel-footer" style="display: flex; justify-content:空间-between; align-items: center; width: 100%;">
                            @* Butonul de Reset (stânga) *@
                            <button class="reset-inner-btn" @onclick="ResetDraftFilters">Clear All</button>

                            @* Butonul de Apply (dreapta) *@
                            <button class="apply-btn" @onclick="HandleApply">Apply Filters</button>
                        </div>
                    </div>
                }

                @* LOGICA PENTRU ALINIERE: 
       Dacă Sort e deschis DAR Filter e închis, punem un spacer în stânga 
       pentru a împinge panoul de Sort sub butonul lui din dreapta *@
                @if (isSortOpen && !isFilterOpen)
                {
                    <div class="spacer"></div>
                }

                @if (isSortOpen)
                {
                    <div class="editorial-panel sort-panel animate-slide-down">
                        <p class="panel-label">SORT ORDER</p>
                        <div class="pills-grid">
                            <button class="pill-btn @(DraftFilter.SortBy == "Newest" ? "active" : "")" @onclick='() => SetSort("Newest")'>Newest First</button>
                            <button class="pill-btn @(DraftFilter.SortBy == "Oldest" ? "active" : "")" @onclick='() => SetSort("Oldest")'>Oldest First</button>
                        </div>

                        @* Footer adăugat pentru sortare *@
                        <div class="panel-footer">
                            <button class="reset-inner-btn" @onclick="ResetDraftFilters">Clear All</button>
                            <button class="apply-btn" @onclick="HandleApply">Apply Sort</button>
                        </div>
                    </div>
                }
            </div>
            </div>

        <div class="wardrobe-scroll-area">
            <div class="editorial-grid">
                @if (isLoading)
                {
                    @for (int i = 0; i < 9; i++)
                    {
                        <div class="skeleton-card-editorial"></div>
                    }
                }
                else if (AllItems == null || !AllItems.Any())
                {
                    @* Statut gol total (fără niciun item în bază) *@
                    <div class="empty-state-full">
                        <div class="empty-box-dashed" @onclick='() => NavigationManager.NavigateTo("/add-item")'>
                            <span class="plus-large">+</span>
                            <p>Your closet is empty.</p>
                            <p class="sub-text">Start building your collection now.</p>
                        </div>
                    </div>
                }
                else if (!FilteredItems.Any())
                {
                    @* Statut "Nicio potrivire": Ascundem cardul "+" și centrăm textul *@
                    <div class="no-matches-centered">
                        <div class="empty-search-icon">🔍</div>
                        <p class="empty-state-editorial">No matches found for "@Filter.SearchTerm"</p>
                        <button class="reset-link-editorial" @onclick="ResetFilters" style="margin: 10px auto;">Clear Search</button>
                    </div>
                }
                else
                {
                    @* Cardul "+" apare DOAR dacă avem rezultate sau suntem pe vizualizarea generală *@
                    <div class="wardrobe-card-editorial add-new-dashed" @onclick='() => NavigationManager.NavigateTo("/add-item")'>
                        <span class="plus-symbol">+</span>
                    </div>
                    @foreach (var item in FilteredItems)
                    {
                        @* Verificăm dacă haina curentă este selectată pentru outfit *@
                        bool isSelected = IsSelectionMode && SelectedItems.Any(i => i.Id == item.Id);

                        <div class="wardrobe-card-editorial animate-card-stagger @(isSelected ? "selected-glow" : "")"
                             @onclick="() => HandleItemClick(item)">

                            <div class="image-container-padded">
                                <img src="@GetImageSource(item.ImagePath)" alt="wardrobe item" />

                                @* Afișăm bifa roz (checkmark) doar în modul de selecție și dacă haina e aleasă *@
                                @if (isSelected)
                                {
                                    <div class="selection-check-badge">✓</div>
                                }
                            </div>

                            <div class="item-details-box">
                                <h3 class="item-brand-label">
                                    @(!string.IsNullOrWhiteSpace(item.CategoryName) ? item.CategoryName.ToUpper() : "PIECE")
                                </h3>
                                <span class="item-sub-label">
                                    @item.SubcategoryName
                                </span>
                                <div class="item-meta-divider"></div>
                                <span class="meta-season-tag">@(string.IsNullOrWhiteSpace(item.Brand) ? item.Season : item.Brand)</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        </div>
    </div>
</div>
@* Acesta trebuie să fie în afara containerelor cu overflow:hidden *@
<div class="toast-container-editorial">
    @if (localSuccessMessage != null)
    {
        <div class="toast-item-envogue">
            <p>@localSuccessMessage</p>
        </div>
    }
</div>
<NavBar CurrentPage="my-closet" />

<style>
    /* CONTAINERUL PRINCIPAL ALB */
    .selection-card-container {
        background: white;
        border-radius: 40px; /* Margini foarte rotunjite ca în poză */
        padding: 25px;
       
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        border: 1px solid rgba(255,255,255,0.5);
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 30;
        flex: 0 0 auto;
        margin-bottom: 8px;
    }
    /* Selection mode păstrează zona de sus fixă, ca în Closet normal. */
    .content-overlay.selection-scroll {
        height: 100%;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
        padding-top: clamp(22px, 3vh, 42px) !important;
    }

    .selection-scroll .editorial-header {
        margin-bottom: 6px !important;
    }

    .closet-results-scroll {
        display: contents;
    }

    .selection-scroll .closet-results-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
    }

    /* Facem controalele să NU mai fie fixe în acest mod */
    .selection-scroll .search-bar-editorial,
    .selection-scroll .editorial-controls {
        position: relative !important;
        top: auto !important;
        z-index: 10;
    }
    /* Search-ul, filtrele și itemele derulează împreună; headerul și selection box rămân pe loc. */
    .selection-scroll .wardrobe-scroll-area {
        overflow: visible !important;
        display: block !important;
        flex: 0 0 auto !important;
        min-height: 0 !important;
        height: auto !important;
    }
    .selection-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding: 0 5px;
    }

    .selection-title {
        font-size: 18px;
        font-weight: 800;
        color: #2d1b24;
        margin: 0;
    }

    .items-count-badge {
        font-size: 10px;
        font-weight: 800;
        color: #7a5c68;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ZONA DASHED ROZ PAL */
    .canvas-preview-dashed {
        background: #fdf2f8; /* Rozul pal din poză */
        border: 2px dashed #fce7f3;
        border-radius: 24px;
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        overflow-x: auto;
        margin-bottom: 15px;
    }

    .empty-selection-placeholder {
        text-align: center;
        color: #d946ef;
        opacity: 0.5;
    }

    .plus-mini {
        font-size: 24px;
        font-weight: 300;
        display: block;
    }

    .empty-selection-placeholder p {
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 2px;
        margin: 0;
    }

    /* MINIATURI IMAGINI */
    .selected-images-scroll {
        display: flex;
        gap: 12px;
        width: 100%;
    }

    .mini-thumbnail {
        width: 70px;
        height: 90px;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        flex-shrink: 0;
        box-shadow: 0 8px 15px rgba(0,0,0,0.05);
        border: 2px solid white;
    }

        .mini-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* INPUT STILIZAT */
    .outfit-name-field {
        width: 100%;
    }

    .outfit-name-input-styled {
        width: 100%;
        background: white;
        border: 1px solid #fce7f3;
        border-radius: 18px;
        padding: 16px 20px;
        font-size: 14px;
        font-weight: 600;
        outline: none;
        margin-bottom: 12px;
        transition: border-color 0.3s;
    }

        .outfit-name-input-styled:focus {
            border-color: #d946ef;
        }

    .outfit-name-input-styled.input-invalid {
        border-color: #ff2d55;
    }

    .outfit-name-validation-message {
        display: block;
        margin-top: -4px;
        padding-left: 4px;
        font-size: 11px;
        font-weight: 700;
        color: #ff2d55;
    }

    .outfit-style-select-styled {
        width: 100%;
        appearance: none;
        background: white;
        border: 1px solid #fce7f3;
        border-radius: 18px;
        padding: 16px 20px;
        font-size: 14px;
        font-weight: 700;
        color: #342532;
        outline: none;
        margin-bottom: 12px;
        cursor: pointer;
        background-image:
            linear-gradient(45deg, transparent 50%, #d946ef 50%),
            linear-gradient(135deg, #d946ef 50%, transparent 50%);
        background-position:
            calc(100% - 22px) 50%,
            calc(100% - 16px) 50%;
        background-size: 6px 6px, 6px 6px;
        background-repeat: no-repeat;
        transition: border-color 0.3s;
    }

        .outfit-style-select-styled:focus {
            border-color: #d946ef;
        }

    /* BUTONUL CARE SE SCHIMBĂ */
    .save-outfit-btn-styled {
        width: 100%;
        padding: 16px;
        border-radius: 18px;
        border: none;
        font-weight: 900;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        transition: all 0.4s ease;
        cursor: pointer;
    }

    /* Starea inactivă (Gri - image_663f8b) */
    .btn-disabled {
        background: #b5acaf; /* Griul din prima poză */
        color: #f3f3f3;
    }

    /* Starea activă (Negru/Maro închis - image_6642e6) */
    .btn-ready {
        background: #2d1b24; /* Negrul satinat din a doua poză */
        color: white;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

        .btn-ready:active {
            transform: scale(0.98);
        }

    /* ANIMATII */
    @@keyframes pop {
        from

    {
        transform: scale(0.8);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }

    }

    .animate-pop {
        animation: pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .toast-container-editorial {
        position: fixed;
        top: 25px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100000;
        pointer-events: none;
    }

    /* Notificarea stilizată "High-End" */
    .toast-item-envogue {
        background: rgba(255, 255, 255, 0.98); /* Mai opac pentru contrast */
        padding: 14px 28px;
        border-radius: 12px; /* Colțuri mai puțin rotunjite pentru un look mai sofisticat */
        border-left: 4px solid #d946ef; /* O linie de accent roz în stânga */
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        display: flex;
        align-items: center;
        gap: 15px;
        pointer-events: auto;
        animation: toastSlideDown 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

        /* Stil text în interiorul toast-ului */
        .toast-item-envogue p {
            margin: 0;
            font-family: 'Playfair Display', serif; /* Fontul titlului tău */
            font-size: 14px;
            font-weight: 700;
            color: #1a1517 !important;
            letter-spacing: 0.5px;
        }

    /* Iconița cu un mic fundal discret */
    .toast-icon-wrapper {
        background: #fdf2f8;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 16px;
    }

    
    @@keyframes toastSlideDown {
        from

    {
        opacity: 0;
        transform: translateY(-30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
    /* DESIGN EDITORIAL FINAL */
    .brand-title {
        border: none !important;
        outline: none !important;
        font-family: 'Playfair Display', serif;
        font-size: 38px;
        font-weight: 900;
        color: #1a1517;
        line-height: 0.8;
    }

.closet-page-wrapper {
    height: 100vh;
    width: 100%;
    position: relative;
    overflow: hidden;

    background:
        linear-gradient(rgba(253,242,248,0.75), rgba(253,242,248,0.75)),
        url('Images/minimalist_luxury_closet_texture.png');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.editorial-background {
    position: absolute;
    inset: 0;
    z-index: 0;          /* sub tot */
    pointer-events: none; /* nu blochează click-uri */
}

.editorial-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
}
.content-overlay {
    height: 100%;
    display: flex;
    flex-direction: column;

    padding: clamp(30px, 4vh, 60px) 20px 80px;
    box-sizing: border-box;

    overflow: hidden;   /* foarte important */
        overflow-y: auto;
    width: 100%;
    margin: 0;
}

    .scrollable-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .sticky-panel {
        position: sticky;
        top: 0; /* Se va lipi de marginea de sus a containerului */
        z-index: 100; /* Peste cardurile de haine */
        background: white; /* Important: să nu fie transparent să nu se suprapună vizual urât */
        margin-bottom: 20px;
        /* Adăugăm o mică umbră mai pronunțată când e sticky pentru a separa planurile */
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    }
    .editorial-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .collection-tag {
        font-size: 10px;
        font-weight: 800;
        color: #7a5c68;
        letter-spacing: 3px;
        display: block;
        margin-top: 5px;
        text-transform: uppercase;
    }
