    private void ToggleFilter()
    {
        if (!isFilterOpen)
        {
            DraftFilter = CloneFilter(Filter);
            UpdateSubcategories(DraftFilter);
            isFilterOpen = true;
            isSortOpen = false; // Închide sortarea dacă deschizi filtrele
        }
        else
        {
            isFilterOpen = false;
        }
    }
    private void ToggleSort()
    {
        if (!isSortOpen)
        {
            DraftFilter = CloneFilter(Filter);
            isSortOpen = true;
            isFilterOpen = false; // Închide filtrele dacă deschizi sortarea
        }
        else
        {
            isSortOpen = false;
        }
    }
    private void HandleApply()
    {
        // Verificăm dacă există elemente pentru a fi filtrate/sortate
        if (AllItems == null || !AllItems.Any())
        {
            Toast.Show("No items available to filter or sort.", "error");
            ClosePanels();
            return;
        }


        Filter = CloneFilter(DraftFilter);
        UpdateSubcategories(Filter);
        ApplyFilters();
        ClosePanels();

        // Opțional: Notificare de succes pentru feedback vizual
        Toast.Show("Filters applied successfully.", "success");
    }
    private void HandleSearchConfirm()
    {
        // Verificăm dacă baza de date/lista AllItems este goală
        if (AllItems == null || !AllItems.Any())
        {
            Toast.Show("Your closet is empty. There is nothing to search yet.", "error");
            return;
        }

        // Dacă avem haine, executăm căutarea normală (strictă)
        ApplyFilters(isStrict: true);
        ShowNoSearchResultsMessageIfNeeded();
    }
    private string GetImageSource(string? imagePath)
    {
        // Dacă nu avem imagine, punem placeholder-ul tău roz
        if (string.IsNullOrWhiteSpace(imagePath) || imagePath == "du")
        {
            return "Images/placeholder.png";
        }

        // Luăm doar numele fișierului (ex: 74d2a2f0...jpg)
        var fileName = System.IO.Path.GetFileName(imagePath);

        // Returnăm URL-ul care tocmai ți-a mers în browser!
        return $"https://localhost:7081/uploads/images/{fileName}";
    }
    private void HandleInstantSearch(ChangeEventArgs e)
    {
        string currentInput = e.Value?.ToString() ?? "";
        Filter.SearchTerm = currentInput;
        DraftFilter.SearchTerm = currentInput;

        if (AllItems == null || !AllItems.Any())
        {
            if (!string.IsNullOrEmpty(currentInput))
            {
                // Notificăm doar dacă utilizatorul chiar a scris ceva
               Toast.Show("Your closet is empty. Add items to start searching your archive.", "info");
            }
            return;
        }

        // Închidem panourile pentru a vedea rezultatele live
        if (isFilterOpen || isSortOpen)
        {
            isFilterOpen = false;
            isSortOpen = false;
        }

        ApplyFilters(isStrict: false);
    }

    private void HandleSearchEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Verificăm dacă garderoba este goală înainte de a "căuta"
            if (AllItems == null || !AllItems.Any())
            {
                Toast.Show("Your closet is currently empty. Add items to search.", "error");
                return;
            }
            ApplyFilters(isStrict: true);
            ShowNoSearchResultsMessageIfNeeded();
        }
    }
    private void ClosePanels()
    {
        isFilterOpen = false;
        isSortOpen = false;
        StateHasChanged();
    }
    private static FilterModel CloneFilter(FilterModel source) => new()
    {
        SearchTerm = source.SearchTerm,
        SelectedCategory = source.SelectedCategory,
        SelectedSeason = source.SelectedSeason,
        Subcategory = source.Subcategory,
        Color = source.Color,
        Style = string.IsNullOrWhiteSpace(source.Style) ? "All" : source.Style,
        SortBy = string.IsNullOrWhiteSpace(source.SortBy) ? "Newest" : source.SortBy
    };
    private void ShowNoSearchResultsMessageIfNeeded()
    {
        var search = Filter.SearchTerm?.Trim();
        if (!string.IsNullOrWhiteSpace(search) && !FilteredItems.Any())
        {
            Toast.Show($"No item found for \"{search}\".", "info");
        }
    }
    private void ApplyFilters(bool isStrict = false)
    {
        if (AllItems == null || !AllItems.Any())
        {
            FilteredItems = new List<ClothingItem>();
            return;
        }

        // --- 1. SINCRONIZARE DATE (Fix pentru ID -> Text) ---
        foreach (var item in AllItems)
        {
            if (string.IsNullOrEmpty(item.CategoryName) && item.CategoryId.HasValue)
            {
                item.CategoryName = item.CategoryId switch
                {
                    1 => "Tops",
                    2 => "Bottoms",
                    3 => "Shoes",
                    4 => "Accessories",
                    5 => "Dress",
                    6 => "Outerwear",
                    _ => "Unknown"
                };
            }

            if (string.IsNullOrEmpty(item.SubcategoryName) && item.SubcategoryId.HasValue)
            {
                item.SubcategoryName = item.SubcategoryId switch
                {
                    1 => "T-shirt",
                    2 => "Blouse",
                    3 => "Sweater",
                    4 => "Hoodie",
                    5 => "Jeans",
                    6 => "Trousers",
                    7 => "Shorts",
                    8 => "Skirt",
                    9 => "Sneakers",
                    10 => "Boots",
                    11 => "Sandals",
                    15 => "Heels",
                    12 => "Hat",
                    13 => "Belt",
                    14 => "Scarf",
                    16 => "Jewelry",
                    17 => "Mini",
                    18 => "Maxi",
                    19 => "Cocktail",
                    20 => "Evening",
                    21 => "Jacket",
                    22 => "Coat",
                    23 => "Blazer",
                    24 => "Vest",
                    _ => "Other"
                };
            }
        }

        var query = AllItems.AsQueryable();

        // --- 2. LOGICA DE SEARCH INTELIGENTĂ ---
        var rawSearch = Filter.SearchTerm?.Trim() ?? "";
        var search = rawSearch.ToLower();
        if (!string.IsNullOrEmpty(search))
        {
            if (isStrict)
            {
                query = query.Where(item =>
                    (item.Name != null && item.Name.Equals(rawSearch, StringComparison.OrdinalIgnoreCase)) ||
                    (item.Brand != null && item.Brand.Equals(rawSearch, StringComparison.OrdinalIgnoreCase)) ||
                    (item.CategoryName != null && item.CategoryName.Equals(rawSearch, StringComparison.OrdinalIgnoreCase)) ||
                    (item.SubcategoryName != null && item.SubcategoryName.Equals(rawSearch, StringComparison.OrdinalIgnoreCase)) ||
                    (item.Season != null && item.Season.Equals(rawSearch, StringComparison.OrdinalIgnoreCase)) ||
                    (item.Style != null && item.Style.Equals(rawSearch, StringComparison.OrdinalIgnoreCase)) ||
                    (item.Color != null && item.Color.Equals(rawSearch, StringComparison.OrdinalIgnoreCase))
                );
            }
            else
            {
                // Împărțim căutarea în cuvinte individuale (ex: "t-shirt summer" devine ["t-shirt", "summer"])
                var keywords = search.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                query = query.Where(item => keywords.All(key =>
                    (item.Name != null && item.Name.ToLower().Contains(key)) ||
                    (item.Brand != null && item.Brand.ToLower().Contains(key)) ||
                    (item.CategoryName != null && item.CategoryName.ToLower().Contains(key)) ||
                    (item.SubcategoryName != null && item.SubcategoryName.ToLower().Contains(key)) ||
                    (item.Season != null && item.Season.ToLower().Contains(key)) ||
                    (item.Style != null && item.Style.ToLower().Contains(key)) ||
                    (item.Color != null && item.Color.ToLower().Contains(key))
                ));
            }
        }

        // --- 3. FILTRELE DIN PANOU (Folosim StringComparison pentru a ignora literele mari/mici) ---

        // Categorie
        if (Filter.SelectedCategory != "All")
            query = query.Where(i => i.CategoryName != null && i.CategoryName.Equals(Filter.SelectedCategory, StringComparison.OrdinalIgnoreCase));

        // Subcategorie
        if (!string.IsNullOrEmpty(Filter.Subcategory))
            query = query.Where(i => i.SubcategoryName != null && i.SubcategoryName.Equals(Filter.Subcategory, StringComparison.OrdinalIgnoreCase));

        // Culoare
        if (!string.IsNullOrEmpty(Filter.Color))
            query = query.Where(i => i.Color != null && i.Color.Contains(Filter.Color, StringComparison.OrdinalIgnoreCase));

        // Sezon
        if (Filter.SelectedSeason != "All")
            query = query.Where(i => i.Season != null && i.Season.Equals(Filter.SelectedSeason, StringComparison.OrdinalIgnoreCase));

        // Stil
        if (Filter.Style != "All" && !string.IsNullOrEmpty(Filter.Style))
            query = query.Where(i => i.Style != null && i.Style.Equals(Filter.Style, StringComparison.OrdinalIgnoreCase));

        // --- 4. SORTARE ---
        FilteredItems = Filter.SortBy switch
        {
            "Brand" => query.OrderBy(i => string.IsNullOrEmpty(i.Brand) ? "ZZZ" : i.Brand).ToList(),
            "Oldest" => query.OrderBy(i => i.Id).ToList(),
            _ => query.OrderByDescending(i => i.Id).ToList()
        };

        if (!string.IsNullOrEmpty(search) && !isStrict)
        {
            FilteredItems = FilteredItems
                .OrderByDescending(i =>
                    (i.Name?.ToLower().StartsWith(search) ?? false) ||
                    (i.Brand?.ToLower().StartsWith(search) ?? false) ||
                    (i.SubcategoryName?.ToLower().StartsWith(search) ?? false))
                .ThenBy(i => i.Name)
                .ToList();
        }

        StateHasChanged();
    }
    private async Task HandleSaveOutfitClick()
    {
        if (!SelectedItems.Any())
        {
            Toast.Show("Please select at least one item for your outfit!", "info");
            return;
        }

        if (string.IsNullOrWhiteSpace(outfitName))
        {
            Toast.Show("Please give your look a name before saving.", "info");
            return;
        }

        if (!IsOutfitNameValid)
        {
            Toast.Show($"Outfit name must have at least {MinOutfitNameLength} characters.", "error");
            return;
        }

        // Dacă validarea trece, salvăm
        await HandleSaveOutfit();
    }
