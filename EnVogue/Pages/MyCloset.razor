@code {
    // --- TOATĂ LOGICA TA INTEGRATĂ (FĂRĂ MODIFICĂRI DE FUNCȚIONARE) ---
    private FilterModel Filter = new FilterModel { SelectedCategory = "All", SelectedSeason = "All", Style = "All", SortBy = "Newest", Subcategory = "" };
    private List<ClothingItem> AllItems = new();
    private List<ClothingItem> FilteredItems = new();
    private List<string> AllCategories = new() { "Tops", "Bottoms", "Dress", "Outerwear", "Shoes", "Accessories" };
    private List<string> PopularColors = new() { "Black", "White", "Gray", "Silver", "Beige", "Brown", "Navy", "Blue", "Red", "Green", "Pink", "Purple", "Gold" };
    private List<string> AvailableSubcategories = new();
    private bool isLoading = true;
    private bool isFilterOpen = false;
    private bool isSortOpen = false;
    private string? localSuccessMessage;

    private Dictionary<string, List<string>> SubcategoryMap = new() {
        { "Tops", new() { "T-shirt", "Blouse", "Sweater", "Hoodie" } },
        { "Bottoms", new() { "Jeans", "Trousers", "Skirt", "Shorts" } },
        { "Dress", new() { "Mini", "Maxi", "Cocktail", "Evening" } },
        { "Outerwear", new() { "Jacket", "Coat", "Blazer", "Vest"} },
        { "Shoes", new() { "Sneakers", "Boots", "Heels", "Sandals"} },
        { "Accessories", new() { "Scarf", "Belt", "Jewelry", "Hat" } }
    };
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await RefreshData();
        UpdateSubcategories();
        WardrobeService.OnChange += HandleOnChange;

        // --- LOGICA PENTRU AFIȘARE MESAJ ȘI CURĂȚARE URL ---
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (uri.Query.Contains("success=true"))
        {
            ShowToast("✨ Item added to your collection!");

            // CURĂȚĂM URL-UL: Înlocuim adresa cu varianta fără parametri
            // 'false' înseamnă că nu reîncărcăm pagina, doar schimbăm textul din bara de sus
            NavigationManager.NavigateTo("/closet", forceLoad: false, replace: true);
        }

        await Task.Delay(800);
        isLoading = false;
    }

    // Această metodă va fi apelată DOAR dacă se schimbă datele în timp ce ești pe pagină
    private void HandleOnChange() => InvokeAsync(async () =>
    {
        await RefreshData();
        ShowToast("Garderobă actualizată!");
    });

    // FUNCȚIA UNICĂ pentru afișarea mesajului
    private void ShowToast(string message)
    {
        localSuccessMessage = message;
        StateHasChanged();

        // Folosim un ID de sesiune simplu sau anulăm task-ul precedent dacă vrei complexitate,
        // dar pentru acest caz e suficient să curățăm după X secunde:
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            localSuccessMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }


    private async Task RefreshData()
    {
        AllItems = WardrobeService.GetAllClothes();
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleFilter() { isFilterOpen = !isFilterOpen; isSortOpen = false; }
    private void ToggleSort() { isSortOpen = !isSortOpen; isFilterOpen = false; }
    private void SetCategory(string cat) { Filter.SelectedCategory = cat; Filter.Subcategory = ""; UpdateSubcategories(); ApplyFilters(); }
    private void UpdateSubcategories() { AvailableSubcategories = SubcategoryMap.ContainsKey(Filter.SelectedCategory) ? SubcategoryMap[Filter.SelectedCategory] : new(); }
    private void SetSubcategory(string sub) { Filter.Subcategory = sub; ApplyFilters(); }
    private void SetColor(string color) { Filter.Color = color; ApplyFilters(); }
    private void SetSeason(string season) { Filter.SelectedSeason = season; ApplyFilters(); }
    private void SetStyle(string style) { Filter.Style = style; ApplyFilters(); }
    private void SetSort(string sort) { Filter.SortBy = sort; ApplyFilters(); }
    private void ResetFilters() { Filter = new FilterModel { SelectedCategory = "All", SelectedSeason = "All", Style = "All", SortBy = "Newest" }; UpdateSubcategories(); ApplyFilters(); }

    private string GetColorHex(string colorName) => colorName.ToLower() switch
    {
        "black" => "#1a1a1a",
        "white" => "#ffffff",
        "gray" => "#808080",
        "silver" => "#c0c0c0",
        "beige" => "#f5f5dc",
        "brown" => "#8b4513",
        "navy" => "#000080",
        "blue" => "#3b82f6",
        "red" => "#ef4444",
        "green" => "#22c55e",
        "pink" => "#ec4899",
        "purple" => "#a855f7",
        "gold" => "#ffd700",
        _ => "#808080"
    };

    private string GetImageSource(byte[]? imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return "Images/placeholder.png"; // opțional

        return $"data:image/jpeg;base64,{Convert.ToBase64String(imageBytes)}";
    }

    private void ApplyFilters()
    {
        var query = AllItems.AsQueryable();
        var search = Filter.SearchTerm?.Trim().ToLower() ?? "";
        if (!string.IsNullOrEmpty(search))
        {
            var searchTerms = search.Replace("-", " ").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            foreach (var term in searchTerms)
            {
                query = query.Where(i => (i.Brand != null && i.Brand.ToLower().Contains(term)) || (i.Category != null && i.Category.ToLower().Contains(term)) || (i.Subcategory != null && i.Subcategory.ToLower().Replace("-", " ").Contains(term)) || (i.Color != null && i.Color.ToLower().Contains(term)));
            }
        }
        if (Filter.SelectedCategory != "All") query = query.Where(i => i.Category.Equals(Filter.SelectedCategory, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(Filter.Subcategory)) query = query.Where(i => i.Subcategory == Filter.Subcategory);
        if (!string.IsNullOrEmpty(Filter.Color)) query = query.Where(i => i.Color.Contains(Filter.Color, StringComparison.OrdinalIgnoreCase));
        if (Filter.SelectedSeason != "All") query = query.Where(i => i.Season.Equals(Filter.SelectedSeason, StringComparison.OrdinalIgnoreCase));
        if (Filter.Style != "All" && !string.IsNullOrEmpty(Filter.Style)) query = query.Where(i => i.Style.Equals(Filter.Style, StringComparison.OrdinalIgnoreCase));

        FilteredItems = Filter.SortBy switch
        {
            "Brand" => query.OrderBy(i => string.IsNullOrEmpty(i.Brand) ? "ZZZ" : i.Brand).ToList(),
            "Oldest" => query.OrderBy(i => i.Id).ToList(),
            _ => query.OrderByDescending(i => i.Id).ToList()
        };
        StateHasChanged();
    }
    public void Dispose() => WardrobeService.OnChange -= HandleOnChange;
}