@page "/privacy"
@using EnVogue.Services
@using EnVogue.Shared
@inject UserState UserState
@inject NavigationManager Nav
@inject NotificationService Toast
@inject WardrobeServices WardrobeService
@inject ProfilePhotoService ProfilePhotoService
@inject AccountProfileService AccountProfileService
@layout EmptyLayout

<div class="privacy-page-wrapper">
    <header class="editorial-header-unified">
        <div class="header-left">
            <div class="brand-nav-group">
                <BackCircleButton FallbackRoute="/profile" />
                <div class="brand-text-block">
                    <h1 class="brand-title-unified no-border">EnVogue</h1>
                    <span class="collection-tag-unified closet-color">PRIVACY</span>
                </div>
            </div>
        </div>
    </header>

    <div class="privacy-content-shell">
        @if (!UserState.IsLoggedIn)
        {
            <div class="privacy-locked-card">
                <h2>Private member area</h2>
                <p>Please log in to manage your password and account security.</p>
                <button class="primary-privacy-btn" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
            </div>
        }
        else
        {
            <div class="privacy-page-grid">
                <section class="privacy-hero-card">
                    <div class="privacy-icon-chip">🛡️</div>
                    <h2>Privacy & Security</h2>
                    <p>Your account settings live here. You can update your password, review how your access works, or permanently delete the account if needed.</p>

                    <div class="privacy-summary-list">
                        <div class="privacy-summary-item">
                            <span class="privacy-summary-label">Email</span>
                            <strong>@(UserState.Email ?? "Member account")</strong>
                        </div>
                        <div class="privacy-summary-item">
                            <span class="privacy-summary-label">Profile Sync</span>
                            <strong>@(ProfilePhotoService.HasPhoto ? "Profile photo added" : "Photo optional")</strong>
                        </div>
                        <div class="privacy-summary-item">
                            <span class="privacy-summary-label">Security</span>
                            <strong>Password protected</strong>
                        </div>
                    </div>
                </section>

                <div class="privacy-right-column">
                    <section class="privacy-form-card">
                        <div class="privacy-card-header">
                            <div>
                                <h3>Change Password</h3>
                                <p>Update your password whenever you want a fresh sign-in.</p>
                            </div>
                        </div>

                        <div class="privacy-form-grid">
                            <label class="privacy-field privacy-field-full">
                                <span>Current Password</span>
                                <div class="password-field-shell">
                                    <input type="@(showCurrentPassword ? "text" : "password")" @bind="currentPassword" autocomplete="current-password" />
                                    <button class="password-visibility-btn" type="button" @onclick="() => showCurrentPassword = !showCurrentPassword" aria-label="Toggle current password visibility">
                                        @if (showCurrentPassword)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 3l18 18"></path>
                                                <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58"></path>
                                                <path d="M9.88 5.09A9.77 9.77 0 0 1 12 5c5 0 9 7 9 7a17.45 17.45 0 0 1-2.16 2.94"></path>
                                                <path d="M6.53 6.53C4.6 7.9 3 10 3 12c0 0 4 7 9 7a8.9 8.9 0 0 0 5.47-1.93"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </label>

                            <label class="privacy-field">
                                <span>New Password</span>
                                <div class="password-field-shell">
                                    <input type="@(showNewPassword ? "text" : "password")" @bind="newPassword" autocomplete="new-password" />
                                    <button class="password-visibility-btn" type="button" @onclick="() => showNewPassword = !showNewPassword" aria-label="Toggle new password visibility">
                                        @if (showNewPassword)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 3l18 18"></path>
                                                <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58"></path>
                                                <path d="M9.88 5.09A9.77 9.77 0 0 1 12 5c5 0 9 7 9 7a17.45 17.45 0 0 1-2.16 2.94"></path>
                                                <path d="M6.53 6.53C4.6 7.9 3 10 3 12c0 0 4 7 9 7a8.9 8.9 0 0 0 5.47-1.93"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </label>

                            <label class="privacy-field">
                                <span>Confirm Password</span>
                                <div class="password-field-shell">
                                    <input type="@(showConfirmPassword ? "text" : "password")" @bind="confirmNewPassword" autocomplete="new-password" />
                                    <button class="password-visibility-btn" type="button" @onclick="() => showConfirmPassword = !showConfirmPassword" aria-label="Toggle confirm password visibility">
                                        @if (showConfirmPassword)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 3l18 18"></path>
                                                <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58"></path>
                                                <path d="M9.88 5.09A9.77 9.77 0 0 1 12 5c5 0 9 7 9 7a17.45 17.45 0 0 1-2.16 2.94"></path>
                                                <path d="M6.53 6.53C4.6 7.9 3 10 3 12c0 0 4 7 9 7a8.9 8.9 0 0 0 5.47-1.93"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </label>
                        </div>

                        <div class="privacy-inline-hint">
                            Use at least 8 characters and choose something you do not reuse elsewhere.
                        </div>

                        <div class="privacy-actions">
                            <button class="secondary-privacy-btn" @onclick="ResetPasswordForm" type="button">Reset</button>
                            <button class="primary-privacy-btn" @onclick="SavePassword" type="button">Save Password</button>
                        </div>
                    </section>

                    <section class="danger-zone-card">
                        <div class="privacy-card-header">
                            <div>
                                <h3>Delete Account</h3>
                                <p>This permanently removes your account access. Use it only if you are sure.</p>
                            </div>
                        </div>

                        <label class="privacy-field privacy-field-full">
                            <span>Current Password</span>
                            <div class="password-field-shell">
                                <input type="@(showDeletePassword ? "text" : "password")" @bind="deletePassword" autocomplete="current-password" />
                                <button class="password-visibility-btn" type="button" @onclick="() => showDeletePassword = !showDeletePassword" aria-label="Toggle delete password visibility">
                                    @if (showDeletePassword)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 3l18 18"></path>
                                            <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58"></path>
                                            <path d="M9.88 5.09A9.77 9.77 0 0 1 12 5c5 0 9 7 9 7a17.45 17.45 0 0 1-2.16 2.94"></path>
                                            <path d="M6.53 6.53C4.6 7.9 3 10 3 12c0 0 4 7 9 7a8.9 8.9 0 0 0 5.47-1.93"></path>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </label>

                        <div class="danger-zone-copy">
                            Deleting your account signs you out and removes your access to your private archive on this account.
                        </div>

                        <div class="danger-zone-actions">
                            <button class="danger-privacy-btn" @onclick="RequestDeleteAccount" type="button">Delete Account</button>
                        </div>
                    </section>
                </div>
            </div>
        }
    </div>
</div>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Account"
               Message="Are you sure you want to permanently delete this account? This action cannot be undone."
               ConfirmText="Delete"
               CancelText="Keep Account"
               ConfirmButtonClass="btn-danger-modal"
               OnConfirm="ConfirmDeleteAccount"
               OnCancel="CancelDeleteAccount" />

<NavBar CurrentPage="profile" />

<style>
    .privacy-page-wrapper {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        background: linear-gradient(rgba(253,242,248,0.58), rgba(253,242,248,0.58)), url('Images/minimalist_luxury_interior_texture_for_profile.png');
        background-size: cover;
        background-position: center;
        overflow-y: auto;
    }

    .editorial-header-unified {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: clamp(25px, 4vh, 60px) 20px 0;
        z-index: 1000;
    }

    .brand-nav-group {
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }

    .brand-text-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .brand-title-unified {
        font-family: 'Playfair Display', serif;
        font-size: 38px;
        font-weight: 900;
        line-height: 0.8;
        margin: 0;
        color: black;
    }

    .no-border {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
    }

    .collection-tag-unified {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 3px;
        display: block;
        margin-top: 5px;
        text-transform: uppercase;
        opacity: 0.8;
    }

    .closet-color {
        color: #7a5c68;
    }

    .privacy-content-shell {
        width: min(100%, 1100px);
        margin: 0 auto;
        min-height: calc(100vh - 96px);
        padding: 126px 20px 120px;
        box-sizing: border-box;
    }

    .privacy-page-grid {
        display: grid;
        grid-template-columns: minmax(280px, 320px) minmax(0, 1fr);
        gap: 28px;
        align-items: start;
    }

    .privacy-right-column {
        display: grid;
        gap: 16px;
    }

    .privacy-hero-card,
    .privacy-form-card,
    .danger-zone-card,
    .privacy-locked-card {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(18px);
        border-radius: 34px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.07);
    }

    .privacy-hero-card {
        padding: 28px 24px;
        display: grid;
        gap: 18px;
        position: sticky;
        top: 130px;
    }

    .privacy-icon-chip {
        width: 68px;
        height: 68px;
        border-radius: 22px;
        background: #fff5fb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        box-shadow: 0 12px 28px rgba(217, 70, 239, 0.12);
    }

    .privacy-hero-card h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
        color: #1a1517;
    }

    .privacy-hero-card p {
        margin: 0;
        color: #7a5c68;
        font-size: 14px;
        line-height: 1.6;
    }

    .privacy-summary-list {
        display: grid;
        gap: 10px;
    }

    .privacy-summary-item {
        min-height: 58px;
        border-radius: 18px;
        background: #faf7fa;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
    }

    .privacy-summary-label {
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        color: #9b7f8b;
    }

    .privacy-summary-item strong {
        font-size: 14px;
        color: #1a1517;
        font-weight: 800;
    }

    .privacy-form-card,
    .danger-zone-card {
        padding: 18px 24px;
    }

    .privacy-card-header {
        margin-bottom: 14px;
    }

    .privacy-card-header h3 {
        margin: 0 0 4px;
        font-size: 23px;
        font-weight: 900;
        color: #1a1517;
    }

    .privacy-card-header p {
        margin: 0;
        color: #7a5c68;
        font-size: 13px;
        line-height: 1.5;
    }

    .privacy-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 14px;
    }

    .privacy-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .privacy-field-full {
        grid-column: 1 / -1;
    }

    .privacy-field span {
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: #7a5c68;
    }

    .privacy-field input {
        width: 100%;
        border: 1px solid #f0e5ec;
        background: #fff;
        border-radius: 16px;
        min-height: 42px;
        padding: 10px 14px;
        font-size: 14px;
        color: #1a1517;
        outline: none;
        box-sizing: border-box;
    }

    .password-field-shell {
        position: relative;
    }

    .password-field-shell input {
        padding-right: 48px;
    }

    .password-visibility-btn {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        padding: 0;
        border: none;
        background: transparent;
        color: #8f7a85;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .password-visibility-btn svg {
        width: 20px;
        height: 20px;
    }

    .privacy-inline-hint,
    .danger-zone-copy {
        margin-top: 10px;
        font-size: 13px;
        line-height: 1.45;
        color: #7a5c68;
    }

    .privacy-actions,
    .danger-zone-actions {
        margin-top: 12px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .primary-privacy-btn,
    .secondary-privacy-btn,
    .danger-privacy-btn {
        min-height: 40px;
        border-radius: 16px;
        padding: 0 22px;
        border: none;
        font-weight: 800;
        cursor: pointer;
    }

    .primary-privacy-btn {
        background: #1a1517;
        color: white;
    }

    .secondary-privacy-btn {
        background: white;
        color: #1a1517;
        border: 1px solid #f0e5ec;
    }

    .danger-privacy-btn {
        background: #fff1f2;
        color: #ef4444;
    }

    .privacy-locked-card {
        width: min(100%, 460px);
        margin: 120px auto 0;
        padding: 32px 28px;
        text-align: center;
    }

    .privacy-locked-card h2 {
        margin: 0 0 10px;
        font-size: 28px;
        font-weight: 900;
        color: #1a1517;
    }

    .privacy-locked-card p {
        margin: 0 0 18px;
        color: #7a5c68;
    }

    @@media (max-width: 900px) {
        .privacy-page-grid {
            grid-template-columns: 1fr;
        }

        .privacy-hero-card {
            position: static;
        }
    }

    @@media (max-width: 768px) {
        .privacy-page-wrapper {
            position: fixed !important;
            inset: 0 !important;
            overflow: hidden !important;
        }

            .privacy-page-wrapper .editorial-header-unified {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                z-index: 9999 !important;
                height: 95px !important;
                padding: 20px 20px 0 !important;
                background: transparent !important;
                backdrop-filter: none !important;
            }

            .privacy-page-wrapper .privacy-content-shell {
                position: fixed !important;
                top: 95px !important;
                left: 0 !important;
                right: 0 !important;
                bottom: 90px !important;
                height: auto !important;
                min-height: 0 !important;
                padding: 10px 18px 20px !important;
                overflow-y: auto !important;
                overflow-x: hidden !important;
                box-sizing: border-box !important;
                -webkit-overflow-scrolling: touch !important;
            }

            .privacy-page-wrapper .privacy-page-grid {
                grid-template-columns: 1fr !important;
                gap: 14px !important;
            }

            .privacy-page-wrapper .privacy-hero-card,
            .privacy-page-wrapper .privacy-form-card,
            .privacy-page-wrapper .danger-zone-card {
                width: 88% !important;
                margin: 0 auto !important;
                border-radius: 24px !important;
                padding: 18px 16px !important;
                max-height: none !important;
                position: static !important;
            }

            .privacy-page-wrapper .privacy-icon-chip {
                width: 52px !important;
                height: 52px !important;
                border-radius: 18px !important;
                font-size: 24px !important;
            }

            .privacy-page-wrapper .privacy-hero-card {
                gap: 12px !important;
            }

                .privacy-page-wrapper .privacy-hero-card h2,
                .privacy-page-wrapper .privacy-card-header h3 {
                    font-size: 22px !important;
                    line-height: 1.1 !important;
                }

                .privacy-page-wrapper .privacy-hero-card p,
                .privacy-page-wrapper .privacy-card-header p,
                .privacy-page-wrapper .privacy-inline-hint,
                .privacy-page-wrapper .danger-zone-copy {
                    font-size: 12px !important;
                    line-height: 1.45 !important;
                }

            .privacy-page-wrapper .privacy-summary-list {
                gap: 7px !important;
            }

            .privacy-page-wrapper .privacy-summary-item {
                min-height: 46px !important;
                border-radius: 14px !important;
                padding: 9px 12px !important;
            }

            .privacy-page-wrapper .privacy-summary-label {
                font-size: 8px !important;
                letter-spacing: 1.2px !important;
            }

            .privacy-page-wrapper .privacy-summary-item strong {
                font-size: 12px !important;
                word-break: break-word !important;
            }

            .privacy-page-wrapper .privacy-right-column {
                gap: 14px !important;
            }

            .privacy-page-wrapper .privacy-form-grid {
                grid-template-columns: 1fr !important;
                gap: 10px !important;
            }

            .privacy-page-wrapper .privacy-field {
                gap: 5px !important;
            }

                .privacy-page-wrapper .privacy-field span {
                    font-size: 9px !important;
                    letter-spacing: 1.3px !important;
                }

                .privacy-page-wrapper .privacy-field input {
                    min-height: 42px !important;
                    padding: 10px 44px 10px 12px !important;
                    border-radius: 14px !important;
                    font-size: 16px !important;
                }

            .privacy-page-wrapper .password-visibility-btn {
                right: 12px !important;
                width: 22px !important;
                height: 22px !important;
            }

                .privacy-page-wrapper .password-visibility-btn svg {
                    width: 18px !important;
                    height: 18px !important;
                }

            .privacy-page-wrapper .privacy-actions,
            .privacy-page-wrapper .danger-zone-actions {
                flex-direction: column !important;
                gap: 10px !important;
                margin-top: 14px !important;
            }

            .privacy-page-wrapper .primary-privacy-btn,
            .privacy-page-wrapper .secondary-privacy-btn,
            .privacy-page-wrapper .danger-privacy-btn {
                width: 100% !important;
                min-height: 42px !important;
                border-radius: 15px !important;
                font-size: 12px !important;
            }

            .privacy-page-wrapper .privacy-locked-card {
                width: 82% !important;
                max-width: 340px !important;
                min-height: 185px !important;
                margin: 0 auto !important;
                padding: 34px 24px !important;
                border-radius: 30px !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
            }

            .privacy-page-wrapper .privacy-content-shell:has(.privacy-locked-card) {
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                overflow: hidden !important;
            }

            .privacy-page-wrapper .privacy-locked-card h2 {
                font-size: 24px !important;
                line-height: 1.1 !important;
            }

            .privacy-page-wrapper .privacy-locked-card p {
                font-size: 14px !important;
                line-height: 1.5 !important;
                margin: 14px 0 18px !important;
            }
    }
    
</style>

@code {
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmNewPassword = string.Empty;
    private string deletePassword = string.Empty;
    private bool showDeleteConfirm;
    private bool showCurrentPassword;
    private bool showNewPassword;
    private bool showConfirmPassword;
    private bool showDeletePassword;

    private void ResetPasswordForm()
    {
        currentPassword = string.Empty;
        newPassword = string.Empty;
        confirmNewPassword = string.Empty;
        Toast.Show("Password form reset.", "success");
    }

    private async Task SavePassword()
    {
        if (string.IsNullOrWhiteSpace(currentPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmNewPassword))
        {
            Toast.Show("Please complete all password fields.", "error");
            return;
        }

        if (newPassword.Length < 8)
        {
            Toast.Show("Your new password must be at least 8 characters.", "error");
            return;
        }

        if (string.Equals(currentPassword, newPassword, StringComparison.Ordinal))
        {
            Toast.Show("Your new password must be different from the current one.", "error");
            return;
        }

        if (!string.Equals(newPassword, confirmNewPassword, StringComparison.Ordinal))
        {
            Toast.Show("New password and confirmation do not match.", "error");
            return;
        }

        var result = await WardrobeService.ChangePasswordAsync(currentPassword, newPassword);
        if (!result.Success)
        {
            Toast.Show(result.Message, "error");
            return;
        }

        currentPassword = string.Empty;
        newPassword = string.Empty;
        confirmNewPassword = string.Empty;
        showCurrentPassword = false;
        showNewPassword = false;
        showConfirmPassword = false;
        Toast.Show(result.Message, "success");
    }

    private void RequestDeleteAccount()
    {
        if (string.IsNullOrWhiteSpace(deletePassword))
        {
            Toast.Show("Please enter your current password first.", "error");
            return;
        }

        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAccount()
    {
        var result = await WardrobeService.DeleteAccountAsync(deletePassword);
        if (!result.Success)
        {
            showDeleteConfirm = false;
            Toast.Show(result.Message, "error");
            return;
        }

        await ProfilePhotoService.DeleteStoredPhotoForCurrentUserAsync();
        await AccountProfileService.DeleteStoredProfileForCurrentUserAsync();
        await WardrobeService.LogoutAsync();
        await ProfilePhotoService.ClearLoadedStateAsync();
        await AccountProfileService.ClearLoadedStateAsync();
        UserState.Logout();

        deletePassword = string.Empty;
        showDeleteConfirm = false;
        Toast.Show(result.Message, "success");
        Nav.NavigateTo("/login");
    }

    private Task CancelDeleteAccount()
    {
        showDeleteConfirm = false;
        return Task.CompletedTask;
    }
}
