@page "/profile"
@using EnVogue.Services
@using EnVogue.Shared
@implements IDisposable
@inject UserState UserState
@inject NavigationManager Nav
@inject NotificationService Toast
@inject WardrobeServices WardrobeService
@inject ProfilePhotoService ProfilePhotoService
@inject AccountProfileService AccountProfileService
@inject IJSRuntime JS
@layout EmptyLayout

<div class="profile-page-wrapper">
    @* HEADER UNIFICAT IDENTIC CU ADD ITEM / STUDIO *@
    <header class="editorial-header-unified">
        <div class="header-left">
            <div class="brand-nav-group">
                @* BUTON BACK UNIFICAT (CERC ALB) - AFIȘAT PESTE TOT *@
                <BackCircleButton FallbackRoute="/home" />
                <div class="brand-text-block">
                    <h1 class="brand-title-unified no-border">EnVogue</h1>
                    <span class="collection-tag-unified closet-color">MEMBER PROFILE</span>
                </div>
            </div>
        </div>
    </header>

    <div class="content-container">
        @if (!UserState.IsLoggedIn)
        {
            @* STATE PENTRU UTILIZATOR NEAUTENTIFICAT - FANCY ȘI CENTRAT DUPĂ ACELAȘI MODEL *@
            <div class="profile-main-layout animate-fade-in">

                @* ICONIȚĂ GUEST CENTRATĂ PERFECT PE TOATE REZOLUȚIILE *@
                <div class="avatar-section">
                    <div class="large-avatar-circle auth-placeholder">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="user-info-text">
                        <h2 class="user-display-name">Guest Archive</h2>
                        <p class="user-display-email">Sign in to sync your collection</p>
                    </div>
                </div>

                @* BOX ALB FANCY CU BUTOANE DE ACCES *@
                <div class="luxury-form-card profile-card center-content">
                    <p class="auth-description">Create your digital designer archive and never lose a look again.</p>

                    <div class="auth-btn-group">
                        <button class="add-piece-btn full-width" @onclick='() => Nav.NavigateTo("/login")'>
                            LOG IN TO ACCOUNT
                        </button>

                        <div class="divider-text">OR</div>

                        <button class="action-pill-btn-white full-width" @onclick='() => Nav.NavigateTo("/create-account")'>
                            CREATE NEW ACCOUNT
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* DESIGN PENTRU UTILIZATOR LOGAT - CENTRAT ȘI RIDICAT VISUAL *@
            <div class="profile-main-layout animate-fade-in">
                <div class="avatar-section">
                    @* INIȚIALĂ CENTRATĂ PERFECT PE TOATE REZOLUȚIILE *@
                    <button class="large-avatar-circle avatar-photo-button" @onclick="HandleAvatarClick" type="button">
                        @if (ProfilePhotoService.HasPhoto)
                        {
                            <img src="@ProfilePhotoService.PhotoDataUrl" alt="Profile photo" class="large-avatar-image" />
                        }
                        else
                        {
                            @UserState.Email?.Substring(0, 1).ToUpper()
                        }
                    </button>
                    <div class="user-info-text">
                        <h2 class="user-display-name">@displayName</h2>
                        <p class="user-display-email">@UserState.Email</p>
                    </div>
                </div>

                <div class="luxury-form-card profile-card">
                    <div class="profile-menu-item" @onclick='() => Nav.NavigateTo("/my-account")'>
                        <div class="menu-icon-bg user-icon">👤</div>
                        <div class="menu-text">
                            <span class="menu-label">My Account</span>
                            <span class="menu-sub">EDIT YOUR DETAILS</span>
                        </div>
                        <div class="menu-arrow">›</div>
                    </div>

                    <div class="profile-menu-item" @onclick='() => Nav.NavigateTo("/favorites")'>
                        <div class="menu-icon-bg fav-icon">♡</div>
                        <div class="menu-text">
                            <span class="menu-label">My Favorites</span>
                            <span class="menu-sub">ITEMS YOU LOVE</span>
                        </div>
                        <div class="menu-count">@favoriteCount</div> @* Acesta va fi acum negru *@
                    </div>

                    <div class="profile-menu-item no-border" @onclick='() => Nav.NavigateTo("/privacy")'>
                        <div class="menu-icon-bg privacy-icon">🛡️</div>
                        <div class="menu-text">
                            <span class="menu-label">Privacy</span>
                            <span class="menu-sub">SECURITY SETTINGS</span>
                        </div>
                        <div class="menu-arrow">›</div>
                    </div>

                    <button class="logout-btn-black" @onclick="HandleLogoutRequest">
                        <span class="logout-icon">⇥</span> LOG OUT
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<InputFile id="profile-photo-input"
           OnChange="HandleProfilePhotoSelected"
           accept="image/*"
           style="display:none" />

<ConfirmDialog IsVisible="showLogoutConfirm"
               Title="Logout"
               Message="Are you sure you want to log out?"
               ConfirmText="Logout"
               CancelText="Stay"
               ConfirmButtonClass="btn-confirm-accent"
               OnConfirm="ConfirmLogout"
               OnCancel="() => showLogoutConfirm = false" />

@if (showPhotoActionSheet)
{
    <div class="profile-photo-modal-backdrop" @onclick="ClosePhotoActionSheet">
        <div class="profile-photo-modal-card" @onclick:stopPropagation="true">
            <h3>Profile Photo</h3>
            <p>What would you like to do with your profile photo?</p>
            <div class="profile-photo-modal-actions">
                <button class="profile-photo-secondary-btn" @onclick="OpenPhotoViewer">View photo</button>
                <button class="profile-photo-primary-btn" @onclick="TriggerPhotoPickerFromModal">Change photo</button>
                <button class="profile-photo-danger-btn" @onclick="RemoveProfilePhoto">Delete photo</button>
            </div>
            <button class="profile-photo-link-btn" @onclick="ClosePhotoActionSheet">Cancel</button>
        </div>
    </div>
}

@if (showPhotoViewer && ProfilePhotoService.HasPhoto)
{
    <div class="profile-photo-modal-backdrop" @onclick="ClosePhotoViewer">
        <div class="profile-photo-viewer-card" @onclick:stopPropagation="true">
            <img src="@ProfilePhotoService.PhotoDataUrl" alt="Profile photo preview" class="profile-photo-viewer-image" />
            <button class="profile-photo-link-btn" @onclick="ClosePhotoViewer">Close</button>
        </div>
    </div>
}

<NavBar CurrentPage="profile" />

<style>
    /* FUNDAL SATIN ROZ UNIFICAT */
    .profile-page-wrapper {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        background: linear-gradient(rgba(253,242,248,0.65), rgba(253,242,248,0.65)), url('Images/minimalist_luxury_interior_texture_for_profile.png');
        background-size: cover;
        background-position: center;
        overflow: hidden;
    }

    /* HEADER CSS UNIFICAT */
    .editorial-header-unified {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        /* Am preluat padding-ul exact din Favorites.razor */
        padding: clamp(25px, 4vh, 60px) 20px 0;
        z-index: 1000;
    }

    .brand-nav-group {
        display: flex;
        align-items: flex-start;
        gap: 15px; /* Spațierea identică între butonul Back și Logo */
    }

    .brand-text-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .brand-title-unified {
        font-family: 'Playfair Display', serif;
        font-size: 38px;
        font-weight: 900;
        line-height: 0.8;
        margin: 0;
        color: black;
    }

    /* Logo fancy, curat */
    .no-border {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
    }

    .collection-tag-unified {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 3px;
        display: block;
        margin-top: 5px;
        text-transform: uppercase;
        opacity: 0.8;
    }
    .closet-color {
        color: #7a5c68;
    }

    /* CONTAINER CENTRAT VERTICAL ȘI ORIZONTAL */
    .content-container {
        height: 100vh; /* Obligă containerul să fie cât tot ecranul */
        display: flex;
        flex-direction: column;
        justify-content: center; /* Centrează grupul pe verticală */
        align-items: center; /* Centrează grupul pe orizontală */
        padding: 0 20px;
        z-index: 10;
        /* Ridică totul puțin (-4vh) pentru a nu părea "căzut" spre bară */
        transform: translateY(-4vh);
    }

    .profile-main-layout {
        width: 100%;
        max-width: 420px;
        display: flex;
        flex-direction: column;
        align-items: center; /* Aliniază avatarul cu boxul alb pe centru */
        gap: 20px; /* Spațiu egal între elemente */
        margin: 0 auto; /* Siguranță suplimentară pentru centrare orizontală */
    }

    /* AVATAR ȘI INIȚIALĂ CENTRATĂ */
    .large-avatar-circle {
        width: 100px;
        height: 100px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        color: #d946ef;
        box-shadow: 0 15px 35px rgba(217, 70, 239, 0.2);
        border: 4px solid rgba(255,255,255,0.8);
        margin-bottom: 25px; /* Spațiu între cerc și text */
        margin-left: auto;
        margin-right: auto;
        display: flex;
        border: none;
    }

    .avatar-photo-button {
        cursor: pointer;
        overflow: hidden;
        padding: 0;
    }

    .large-avatar-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        border-radius: 50%;
    }

    .auth-placeholder {
        font-weight: 100;
        opacity: 0.7;
    }

    .user-info-text {
        text-align: center;
    }

    .user-display-name {
        font-family: 'Inter', sans-serif;
        font-weight: 900;
        font-size: 26px;
        color: #1a1517;
        margin: 0;
    }

    .user-display-email {
        font-size: 13px;
        font-weight: 600;
        color: #7a5c68;
        margin-top: 5px;
        opacity: 0.8;
    }

    /* CARD DE MENIU */
    .profile-card {
        width: 100%;
        padding: 25px !important;
        border-radius: 35px !important;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 60px rgba(0,0,0,0.06);
        text-align: center;
    }

    .auth-description {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .profile-menu-item {
        display: flex;
        align-items: center;
        padding: 15px 12px;
        cursor: pointer;
        border-bottom: 1px solid rgba(0,0,0,0.04);
        transition: all 0.3s ease; /* Animație fluidă */
        border-radius: 15px;
    }

        .profile-menu-item:hover {
            background: rgba(255, 255, 255, 0.9); /* Fundal ușor schimbat */
            transform: translateX(8px); /* Mișcare laterală discretă */
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

    .menu-icon-bg {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 18px;
        background: #fdf2f8;
        color: #d946ef;
    }

    .menu-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .menu-label {
        font-weight: 800;
        font-size: 14px;
        color: #1a1517;
    }

    .menu-sub {
        font-size: 8px;
        font-weight: 900;
        color: #aaa;
        letter-spacing: 0.5px;
    }

    /* BUTOANE FANCY */
    .logout-btn-black, .add-piece-btn {
        width: 100%;
        padding: 16px;
        background: #1a1517;
        color: white;
        border: none;
        border-radius: 20px;
        font-weight: 900;
        cursor: pointer;
        transition: 0.3s;
    }

    .menu-arrow {
        color: #000000 !important; /* Forțează culoarea neagră */
        font-size: 20px;
        font-weight: 700; /* Le face puțin mai groase pentru un aspect premium */
        opacity: 1; /* Elimină transparența gri */
    }
        .add-piece-btn:hover, .logout-btn-black:hover {
            background: #d946ef;
        }

    .action-pill-btn-white {
        padding: 14px;
        background: white;
        color: #1a1517;
        border: 1px solid #eee;
        border-radius: 20px;
        font-weight: 800;
        font-size: 12px;
        cursor: pointer;
        width: 100%;
    }

    .menu-count {
        background: transparent; /* Elimină fundalul roz */
        color: #000000 !important; /* Setează textul numărului în negru */
        font-size: 14px; /* Mărește puțin pentru lizibilitate */
        font-weight: 800;
        padding: 0; /* Elimină padding-ul de cerc */
    }

    .profile-menu-item:hover .menu-arrow {
        color: #000000; /* Păstrează săgeata neagră la hover */
    }

    .divider-text {
        margin: 15px 0;
        font-size: 10px;
        font-weight: 900;
        color: #ccc;
        letter-spacing: 2px;
    }

    /* MEDIA QUERIES MOBILE */
    @@media (max-width: 768px) {
        .profile-page-wrapper .editorial-header-unified {
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            height: 80px !important;
            padding: 20px 20px 0 !important;
            margin: 0 !important;
            box-sizing: border-box !important;
        }

        .profile-page-wrapper .header-left {
            display: flex !important;
            align-items: center !important;
        }

        .profile-page-wrapper .brand-nav-group {
            display: flex !important;
            align-items: center !important;
            gap: 10px !important;
        }

        .profile-page-wrapper .brand-title-unified {
            font-size: 24px !important;
            line-height: 1 !important;
            letter-spacing: -0.5px !important;
            margin: 0 !important;
        }

        .profile-page-wrapper .collection-tag-unified {
            font-size: 8px !important;
            letter-spacing: 2px !important;
            margin-top: 0 !important;
        }

    }

    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    .profile-photo-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(25, 18, 24, 0.32);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 12000;
        padding: 20px;
    }

    .profile-photo-modal-card,
    .profile-photo-viewer-card {
        width: min(100%, 360px);
        background: rgba(255, 255, 255, 0.96);
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        text-align: center;
    }

    .profile-photo-modal-card h3 {
        margin: 0 0 8px;
        font-size: 24px;
        font-weight: 900;
        color: #1a1517;
    }

    .profile-photo-modal-card p {
        margin: 0 0 20px;
        color: #7a5c68;
        font-size: 14px;
        line-height: 1.5;
    }

    .profile-photo-modal-actions {
        display: grid;
        gap: 10px;
        margin-bottom: 10px;
    }

    .profile-photo-primary-btn,
    .profile-photo-secondary-btn {
        min-height: 46px;
        border-radius: 18px;
        border: none;
        font-weight: 800;
        cursor: pointer;
    }

    .profile-photo-primary-btn {
        background: #d946ef;
        color: white;
    }

    .profile-photo-secondary-btn {
        background: #f6f0f4;
        color: #2d1b24;
    }

    .profile-photo-danger-btn {
        min-height: 46px;
        border-radius: 18px;
        border: none;
        font-weight: 800;
        cursor: pointer;
        background: #fff1f2;
        color: #ef4444;
    }

    .profile-photo-link-btn {
        border: none;
        background: transparent;
        color: #7a5c68;
        text-decoration: underline;
        font-weight: 700;
        cursor: pointer;
    }

    .profile-photo-viewer-card {
        width: min(100%, 420px);
    }

    .profile-photo-viewer-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 24px;
        display: block;
        margin-bottom: 16px;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

@code {
    private bool showLogoutConfirm = false;
    private bool showPhotoActionSheet = false;
    private bool showPhotoViewer = false;
    private int favoriteCount = 0;
    private int clothingCount = 0;
    private string displayName = "Member";

    protected override async Task OnInitializedAsync()
    {
        // 1. Ne asigurăm că avem cele mai noi date din API
        await WardrobeService.InitializeAsync();
        await ProfilePhotoService.EnsureLoadedAsync();
        var accountProfile = await AccountProfileService.EnsureLoadedAsync();

        displayName = accountProfile?.DisplayName
            ?? UserState.Email?.Split('@')[0]
            ?? "Member";

        RefreshProfileStats();
        WardrobeService.OnChange += HandleWardrobeChanged;
    }

    private void HandleWardrobeChanged() => InvokeAsync(() =>
    {
        RefreshProfileStats();
        StateHasChanged();
    });

    private void RefreshProfileStats()
    {
        clothingCount = WardrobeService.GetAllClothes().Count;
        favoriteCount = WardrobeService.GetAllOutfits().Count(o => o.IsFavorite);
    }

    private void HandleLogoutRequest() => showLogoutConfirm = true;

    private async Task HandleAvatarClick()
    {
        await ProfilePhotoService.EnsureLoadedAsync();

        if (!ProfilePhotoService.HasPhoto)
        {
            await JS.InvokeVoidAsync("envogueProfile.clickById", "profile-photo-input");
            return;
        }

        showPhotoActionSheet = true;
    }

    private async Task HandleProfilePhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Show("Please choose an image file.", "error");
            return;
        }

        try
        {
            var hadPhotoBefore = ProfilePhotoService.HasPhoto;
            var saved = await ProfilePhotoService.SavePhotoAsync(file);
            if (!saved)
            {
                Toast.Show("Profile photo could not be saved.", "error");
                return;
            }

            showPhotoActionSheet = false;
            Toast.Show(hadPhotoBefore ? "Profile photo updated successfully." : "Profile photo added successfully.", "success");
            StateHasChanged();
        }
        catch (IOException)
        {
            Toast.Show("The selected image is too large.", "error");
        }
        catch
        {
            Toast.Show("Profile photo could not be saved.", "error");
        }
    }

    private void OpenPhotoViewer()
    {
        showPhotoActionSheet = false;
        showPhotoViewer = true;
    }

    private async Task TriggerPhotoPickerFromModal()
    {
        showPhotoActionSheet = false;
        await JS.InvokeVoidAsync("envogueProfile.clickById", "profile-photo-input");
    }

    private async Task RemoveProfilePhoto()
    {
        var removed = await ProfilePhotoService.RemovePhotoAsync();
        showPhotoActionSheet = false;

        if (!removed)
        {
            Toast.Show("Profile photo could not be deleted.", "error");
            return;
        }

        showPhotoViewer = false;
        Toast.Show("Profile photo deleted successfully.", "success");
        StateHasChanged();
    }

    private void ClosePhotoActionSheet() => showPhotoActionSheet = false;
    private void ClosePhotoViewer() => showPhotoViewer = false;

    private async Task ConfirmLogout()
    {
        // 1. Executăm logout-ul real (ștergere token)
        await WardrobeService.LogoutAsync();
        await ProfilePhotoService.ClearLoadedStateAsync();
        await AccountProfileService.ClearLoadedStateAsync();

        // 2. Actualizăm starea globală a UI-ului
        UserState.Logout();

        showLogoutConfirm = false;
        Toast.Show("See you soon! Archive secured. ✨", "success");

        // 3. Redirecționăm la Login
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        WardrobeService.OnChange -= HandleWardrobeChanged;
    }
}
