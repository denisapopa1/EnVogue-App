@page "/my-account"
@using EnVogue.Models
@using EnVogue.Services
@inject UserState UserState
@inject NavigationManager Nav
@inject NotificationService Toast
@inject ProfilePhotoService ProfilePhotoService
@inject AccountProfileService AccountProfileService
@inject IJSRuntime JS
@layout EmptyLayout

<div class="my-account-page-wrapper">
    <header class="editorial-header-unified">
        <div class="header-left">
            <div class="brand-nav-group">
                <BackCircleButton FallbackRoute="/profile" />
                <div class="brand-text-block">
                    <h1 class="brand-title-unified no-border">EnVogue</h1>
                    <span class="collection-tag-unified closet-color">MY ACCOUNT</span>
                </div>
            </div>
        </div>
    </header>

    <div class="account-content-shell">
        @if (!UserState.IsLoggedIn)
        {
            <div class="account-locked-card">
                <h2>Member access only</h2>
                <p>Please log in to manage your account details.</p>
                <button class="primary-account-btn" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
            </div>
        }
        else if (editableProfile == null)
        {
            <div class="account-locked-card">
                <h2>Loading your account...</h2>
            </div>
        }
        else
        {
            <div class="account-page-grid">
                <section class="account-hero-card">
                    <button class="account-avatar-button" @onclick="HandleAvatarClick" type="button">
                        @if (ProfilePhotoService.HasPhoto)
                        {
                            <img src="@ProfilePhotoService.PhotoDataUrl" alt="Profile photo" class="account-avatar-image" />
                        }
                        else
                        {
                            <span>@GetAvatarLetter()</span>
                        }
                    </button>

                    <div class="account-identity-copy">
                        <h2>@editableProfile.DisplayName</h2>
                        <p>@editableProfile.Email</p>
                    </div>

                    @if (HeroTags.Count > 0)
                    {
                        <div class="account-identity-tags">
                            @foreach (var tag in HeroTags)
                            {
                                <span>@tag</span>
                            }
                        </div>
                    }
                </section>

                <section class="account-form-card">
                    <div class="account-card-header">
                        <div>
                            <h3>Account Details</h3>
                            <p>Edit the way your profile appears across EnVogue.</p>
                        </div>
                    </div>

                    <div class="account-form-grid">
                        <label class="account-field account-field-full">
                            <span>Display Name</span>
                            <input @bind="editableProfile.DisplayName" maxlength="50" />
                        </label>

                        <label class="account-field account-field-full">
                            <span>Email</span>
                            <input value="@editableProfile.Email" disabled />
                        </label>

                        <label class="account-field">
                            <span>Phone</span>
                            <input @bind="editableProfile.Phone" maxlength="30" placeholder="+40..." />
                        </label>

                        <label class="account-field">
                            <span>City</span>
                            <input @bind="editableProfile.City" maxlength="50" placeholder="Bucharest" />
                        </label>

                        <label class="account-field">
                            <span>Birthday</span>
                            <input @bind="editableProfile.Birthday" maxlength="20" placeholder="26 Apr 2000" />
                        </label>

                        <label class="account-field">
                            <span>Favorite Style</span>
                            <select @bind="editableProfile.FavoriteStyle">
                                <option value="">Select a style</option>
                                <option value="Casual Style">Casual Style</option>
                                <option value="Elegant Style">Elegant Style</option>
                                <option value="Formal Wear">Formal Wear</option>
                                <option value="Sporty Look">Sporty Look</option>
                            </select>
                        </label>

                        <label class="account-field">
                            <span>Instagram</span>
                            <input @bind="editableProfile.InstagramHandle" maxlength="50" placeholder="@@username" />
                        </label>

                        <label class="account-field account-field-full">
                            <span>Favorite Brands</span>
                            <input @bind="editableProfile.FavoriteBrands" maxlength="120" placeholder="Zara, Mango, COS..." />
                        </label>

                        <label class="account-field account-field-full">
                            <span>Preferred Colors</span>
                            <input @bind="editableProfile.PreferredColors" maxlength="120" placeholder="Black, cream, blush pink..." />
                        </label>

                        <label class="account-field account-field-full">
                            <span>About You</span>
                            <textarea @bind="editableProfile.Bio" rows="5" maxlength="280" placeholder="Tell us a little about your style, your mood, your favorite kinds of looks..."></textarea>
                        </label>

                        <label class="account-field account-field-full">
                            <span>Styling Notes</span>
                            <textarea @bind="editableProfile.StylingNotes" rows="4" maxlength="280" placeholder="Anything you want to remember about your styling preferences..."></textarea>
                        </label>
                    </div>

                    <div class="account-actions">
                        <button class="secondary-account-btn" @onclick="ResetChanges" type="button">Reset</button>
                        <button class="primary-account-btn" @onclick="SaveAccountDetails" type="button">Save Details</button>
                    </div>
                </section>
            </div>
        }
    </div>
</div>

<InputFile id="account-photo-input"
           OnChange="HandleProfilePhotoSelected"
           accept="image/*"
           style="display:none" />

@if (showPhotoActionSheet)
{
    <div class="profile-photo-modal-backdrop" @onclick="ClosePhotoActionSheet">
        <div class="profile-photo-modal-card" @onclick:stopPropagation="true">
            <h3>Profile Photo</h3>
            <p>What would you like to do with your profile photo?</p>
            <div class="profile-photo-modal-actions">
                <button class="profile-photo-secondary-btn" @onclick="OpenPhotoViewer">View photo</button>
                <button class="profile-photo-primary-btn" @onclick="TriggerPhotoPickerFromModal">Change photo</button>
                <button class="profile-photo-danger-btn" @onclick="RemoveProfilePhoto">Delete photo</button>
            </div>
            <button class="profile-photo-link-btn" @onclick="ClosePhotoActionSheet">Cancel</button>
        </div>
    </div>
}

@if (showPhotoViewer && ProfilePhotoService.HasPhoto)
{
    <div class="profile-photo-modal-backdrop" @onclick="ClosePhotoViewer">
        <div class="profile-photo-viewer-card" @onclick:stopPropagation="true">
            <img src="@ProfilePhotoService.PhotoDataUrl" alt="Profile photo preview" class="profile-photo-viewer-image" />
            <button class="profile-photo-link-btn" @onclick="ClosePhotoViewer">Close</button>
        </div>
    </div>
}

<NavBar CurrentPage="profile" />

