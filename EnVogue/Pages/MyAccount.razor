@code {
    private AccountProfileDetails? editableProfile;
    private bool showPhotoActionSheet;
    private bool showPhotoViewer;
    private List<string> HeroTags
    {
        get
        {
            if (editableProfile == null)
            {
                return new List<string>();
            }

            var tags = new List<string>();

            if (!string.IsNullOrWhiteSpace(editableProfile.FavoriteStyle))
            {
                tags.Add(editableProfile.FavoriteStyle.Trim());
            }

            if (!string.IsNullOrWhiteSpace(editableProfile.City))
            {
                tags.Add(editableProfile.City.Trim());
            }
            else
            {
                tags.Add("Your wardrobe world");
            }

            if (!string.IsNullOrWhiteSpace(editableProfile.PreferredColors))
            {
                tags.Add(editableProfile.PreferredColors.Trim());
            }

            return tags.Take(3).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn)
        {
            return;
        }

        await ProfilePhotoService.EnsureLoadedAsync();
        editableProfile = await AccountProfileService.GetEditableProfileAsync();
    }

    private string GetAvatarLetter()
    {
        if (!string.IsNullOrWhiteSpace(editableProfile?.DisplayName))
        {
            return editableProfile.DisplayName.Substring(0, 1).ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(UserState.Email))
        {
            return UserState.Email.Substring(0, 1).ToUpperInvariant();
        }

        return "M";
    }

    private async Task SaveAccountDetails()
    {
        if (editableProfile == null)
        {
            return;
        }

        var saved = await AccountProfileService.SaveAsync(editableProfile);
        if (!saved)
        {
            Toast.Show("Account details could not be saved.", "error");
            return;
        }

        editableProfile = await AccountProfileService.GetEditableProfileAsync();
        Toast.Show("Account details saved successfully.", "success");
        StateHasChanged();
    }

    private Task ResetChanges()
    {
        editableProfile = new AccountProfileDetails
        {
            Email = UserState.Email ?? string.Empty,
            DisplayName = GetDefaultDisplayName(),
            Bio = string.Empty,
            Phone = string.Empty,
            City = string.Empty,
            Birthday = string.Empty,
            FavoriteStyle = string.Empty,
            FavoriteBrands = string.Empty,
            PreferredColors = string.Empty,
            InstagramHandle = string.Empty,
            StylingNotes = string.Empty
        };

        Toast.Show("Form reset.", "success");
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string GetDefaultDisplayName()
    {
        if (string.IsNullOrWhiteSpace(UserState.Email))
        {
            return "Member";
        }

        var namePart = UserState.Email.Split('@')[0].Trim();
        return string.IsNullOrWhiteSpace(namePart) ? "Member" : namePart;
    }

    private async Task HandleAvatarClick()
    {
        await ProfilePhotoService.EnsureLoadedAsync();

        if (!ProfilePhotoService.HasPhoto)
        {
            await JS.InvokeVoidAsync("envogueProfile.clickById", "account-photo-input");
            return;
        }

        showPhotoActionSheet = true;
    }

    private async Task HandleProfilePhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Show("Please choose an image file.", "error");
            return;
        }

        try
        {
            var hadPhotoBefore = ProfilePhotoService.HasPhoto;
            var saved = await ProfilePhotoService.SavePhotoAsync(file);
            if (!saved)
            {
                Toast.Show("Profile photo could not be saved.", "error");
                return;
            }

            showPhotoActionSheet = false;
            Toast.Show(hadPhotoBefore ? "Profile photo updated successfully." : "Profile photo added successfully.", "success");
            StateHasChanged();
        }
        catch (IOException)
        {
            Toast.Show("The selected image is too large.", "error");
        }
        catch
        {
            Toast.Show("Profile photo could not be saved.", "error");
        }
    }

    private void OpenPhotoViewer()
    {
        showPhotoActionSheet = false;
        showPhotoViewer = true;
    }

    private async Task TriggerPhotoPickerFromModal()
    {
        showPhotoActionSheet = false;
        await JS.InvokeVoidAsync("envogueProfile.clickById", "account-photo-input");
    }

    private async Task RemoveProfilePhoto()
    {
        var removed = await ProfilePhotoService.RemovePhotoAsync();
        showPhotoActionSheet = false;

        if (!removed)
        {
            Toast.Show("Profile photo could not be deleted.", "error");
            return;
        }

        showPhotoViewer = false;
        Toast.Show("Profile photo deleted successfully.", "success");
        StateHasChanged();
    }

    private void ClosePhotoActionSheet() => showPhotoActionSheet = false;
    private void ClosePhotoViewer() => showPhotoViewer = false;
}
