@page "/add-item"
@inject EnVogue.Services.NotificationService Toast
@using EnVogue.Services
@using EnVogue.Models
@using Microsoft.AspNetCore.Components.Forms
@layout EmptyLayout
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using EnVogue.Models
<div class="add-item-page-wrapper">
    @* FUNDAL SATINAT *@
    <div class="luxury-satin-bg">
        <img src="Images/minimalist_pink_satin_silk_texture_background.png" alt="Satin Background" />
        <div class="dark-overlay"></div>
    </div>

    @* HEADER IDENTIC CU CLOSET (Logo la stânga, Profil la dreapta) *@
    <header class="editorial-header-unified">
        <div class="header-left">
            <div class="brand-nav-group">
                @* Butonul Back micșorat pe mobile *@
                <BackCircleButton OnClick="HandleCancel" UseBrowserBack="false" />
                <div class="brand-text-block">
                    <h1 class="brand-title-unified white-text no-border">EnVogue</h1>
                    <span class="collection-tag-unified white-text">DESIGNER ARCHIVE</span>
                </div>
            </div>
        </div>

        <div class="header-right">
            <div class="header-actions">
                <div class="profile-action">
                    <ProfileAvatarButton AriaLabel="Profile" />
                </div>

                <button class="profile-circle fav-circle" @onclick='() => NavigationManager.NavigateTo("/favorites")' aria-label="Favorites">
                    <svg viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <div class="content-container">
        @* TITLURI RE-CENTRATE ȘI ADAPTIVE *@
        <div class="header-text-group-fit">
            <h2 class="bold-title white-text">New Piece</h2>
            <p class="bold-subtitle white-text">EXPANDING YOUR ARCHIVE</p>
        </div>

        @* CARD COMPACT ȘI PROTEJAT ÎMPOTRIVA DEBORDĂRII *@
        <div class="luxury-form-card animate-fade-in">
            <div class="form-grid">
                <div class="image-upload-section">
                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="file-input-hidden" />
                    @if (string.IsNullOrEmpty(imagePreview))
                    {
                        <div class="upload-box-dashed">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d946ef" stroke-width="1.5">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="17 8 12 3 7 8"></polyline>
                                <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            <span class="upload-label-bold">UPLOAD PHOTO</span>
                        </div>
                    }
                    else
                    {
                        <div class="image-preview-container">
                            <img src="@imagePreview" alt="Preview" />
                        </div>
                    }
                </div>

                <div class="details-input-section">
                    <div class="input-block-fit">
                        <label class="label-bold">BRAND NAME</label>
                        <input type="text" @bind="brand" placeholder="Zara, Nike, Gucci..." />
                    </div>

                    <div class="form-row-fit">
                        <div class="input-block-fit">
                            <label class="label-bold">CATEGORY</label>
                            @* Adăugăm value="@selectedCategoryId" pentru a păstra sincronizarea *@
                            <select @onchange="OnCategoryChanged" value="@selectedCategoryId">
                                @foreach (var cat in CategoriesFromDb)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="input-block-fit">
                            <label class="label-bold">SUBCATEGORY</label>
                            <select @bind="selectedSubcategoryId">
                                @if (SubcategoriesFromDb != null)
                                {
                                    @foreach (var sub in SubcategoriesFromDb.Where(s => s.CategoryId == selectedCategoryId))
                                    {
                                        <option value="@sub.Id">@sub.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        </div>
                    <div class="form-row-fit">
                        <div class="input-block-fit">
                            <label class="label-bold">SEASON</label>
                            <select @bind="season">
                                @foreach (var s in Seasons) { <option value="@s">@s</option> }
                            </select>
                        </div>
                        <div class="input-block-fit">
                            <label class="label-bold">STYLE</label>
                            <select @bind="style">
                                <option value="Casual Style">Casual Style</option>
                                <option value="Formal Wear">Formal Wear</option>
                                <option value="Elegant Style">Elegant Style</option>
                                <option value="Sporty Look">Sporty Look</option>
                            </select>
                        </div>
                    </div>

                    <div class="input-block-fit color-picker-block">
                        <label class="label-bold">COLOR</label>
                        <div class="color-swatch-row">
                            @foreach (var option in ColorOptions)
                            {
                                <button type="button"
                                        class="color-swatch-btn @(color == option ? "active" : "")"
                                        style="@($"--swatch-color: {GetColorHex(option)}")"
                                        title="@option"
                                        aria-label="@($"Select {option}")"
                                        @onclick="() => SetColor(option)">
                                    <span class="color-swatch-dot"></span>
                                </button>
                            }
                        </div>
                        <span class="selected-color-label">@(string.IsNullOrWhiteSpace(color) ? "Choose color" : color)</span>
                    </div>

                    <button class="add-piece-btn" @onclick="SaveItem">ADD TO COLLECTION</button>
                </div>
            </div>
        </div>
    </div>
</div>

<NavBar CurrentPage="home" />

<style>
