    .luxury-satin-bg { position: fixed; inset: 0; z-index: 0; }
    .luxury-satin-bg img { width: 100%; height: 100%; object-fit: cover; }
    .dark-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }

