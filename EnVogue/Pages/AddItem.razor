</style>

@code {
 
    private IBrowserFile? selectedFile; // Reținem fișierul selectat
    private string? imagePreview;
    private string brand = "";
    private string category = "Tops";
    private string subcategory = "";
    private string season = "Summer";
    private string style = "Casual Style";
    private string color = "";
    private List<Category> CategoriesFromDb = new();
    private List<Subcategory> SubcategoriesFromDb = new();
    private int selectedCategoryId; // Aici vom stoca ID-ul ales
    private int selectedSubcategoryId; // ID-ul numeric al subcategoriei

  
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private WardrobeServices WardrobeService { get; set; } = default!;
    @inject HttpClient Client

    private List<string> MainCategories = new() { "Tops", "Bottoms", "Dress", "Outerwear", "Shoes", "Accessories" };
    private List<string> Seasons = new() { "Summer", "Winter", "Spring", "Autumn" };
    private List<string> ColorOptions = new()
    {
        "Black", "White", "Gray", "Silver", "Beige", "Brown", "Navy",
        "Blue", "Red", "Green", "Pink", "Purple", "Gold"
    };
    private Dictionary<string, List<string>> SubcategoryMap = new() {
        { "Tops", new() { "T-shirt", "Blouse", "Hoodie", "Sweater" } },
        { "Bottoms", new() { "Jeans", "Trousers", "Skirt", "Shorts" } },
        { "Dress", new() { "Cocktail", "Maxi", "Mini", "Evening" } },
        { "Outerwear", new() { "Jacket", "Coat", "Blazer", "Vest" } },
        { "Shoes", new() { "Sneakers", "Boots", "Sandals", "Heels" } },
        { "Accessories", new() { "Scarf", "Belt", "Jewelry", "Hat" } }
    };
  
    private void SetColor(string selectedColor)
    {
        color = selectedColor;
    }

    private string GetColorHex(string colorName) => colorName switch
    {
        "Black" => "#1a1a1a",
        "White" => "#ffffff",
        "Gray" => "#808080",
        "Silver" => "#c0c0c0",
        "Beige" => "#f5f5dc",
        "Brown" => "#8b4513",
        "Navy" => "#000080",
        "Blue" => "#3b82f6",
        "Red" => "#ef4444",
        "Green" => "#22c55e",
        "Pink" => "#ec4899",
        "Purple" => "#a855f7",
        "Gold" => "#ffd700",
        _ => "#1a1a1a"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Client.DefaultRequestHeaders.Authorization = null;

            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                Client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            // 2. Încărcăm datele (folosind rutele verificate în Controller)
            // Dacă tot dă 400, încearcă să schimbi GetFromJsonAsync cu GetAsync pentru debug
            CategoriesFromDb = await Client.GetFromJsonAsync<List<Category>>("api/clothing/categories") ?? new();
            SubcategoriesFromDb = await Client.GetFromJsonAsync<List<Subcategory>>("api/clothing/subcategories") ?? new();
            // 2. Inițializăm selecțiile
            if (CategoriesFromDb.Any())
            {
                var firstCat = CategoriesFromDb.First();
                selectedCategoryId = firstCat.Id;
                category = firstCat.Name;

                var firstSub = SubcategoriesFromDb.FirstOrDefault(s => s.CategoryId == selectedCategoryId);
                if (firstSub != null)
                {
                    selectedSubcategoryId = firstSub.Id;
                    subcategory = firstSub.Name;
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"EROARE DETALIATĂ: {ex.Message}");
            Toast.Show("Eroare la comunicarea cu serverul (400)!", "error");
        }
    }
    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedCategoryId = id;
            category = CategoriesFromDb.FirstOrDefault(c => c.Id == id)?.Name ?? "";

            // Căutăm prima subcategorie care aparține de noua categorie selectată
            var firstSub = SubcategoriesFromDb.FirstOrDefault(s => s.CategoryId == selectedCategoryId);
            if (firstSub != null)
            {
                selectedSubcategoryId = firstSub.Id;
                subcategory = firstSub.Name; // Sincronizăm numele pentru SaveItem
            }
            StateHasChanged();
        }
    }
  
    private void HandleCancel() => NavigationManager.NavigateTo("/closet");

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        if (selectedFile == null) return;

        // Creăm preview-ul pentru UI
        var resizedFile = await selectedFile.RequestImageFileAsync(selectedFile.ContentType, 800, 800);
        var buffer = new byte[resizedFile.Size];
        await resizedFile.OpenReadStream().ReadAsync(buffer);
        imagePreview = $"data:{resizedFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task SaveItem()
    {
        // Verificăm dacă utilizatorul a ales o imagine
        if (selectedFile == null)
        {
            Toast.Show("Trebuie să adaugi o imagine!", "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(color))
        {
            Toast.Show("Alege o culoare pentru haină.", "error");
            return;
        }

        try
        {
            // --- PASUL 1: Trimiterea imaginii la API ---
            var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            var fileContent = new StreamContent(fileStream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "file", selectedFile.Name);

            // --- AICI PUNEM TOKEN-UL ---
            // Presupunem că folosești Blazored.LocalStorage sau un serviciu similar injectat ca 'LocalStorage'
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(token))
            {
                Client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }
            // ---------------------------

            // Trimitem către Controller-ul de imagini din Backend
            var uploadResponse = await Client.PostAsync("api/images/upload", content);

            if (!uploadResponse.IsSuccessStatusCode)
            {
                // Dacă primești tot 401 aici, înseamnă că token-ul a expirat sau nu a fost găsit în LocalStorage
                Toast.Show("Eroare la încărcarea imaginii pe server (401)! Te rog să te reloghezi.", "error");

                return;
            }

            // --- PASUL 2: Extragerea numelui REAL (cel lung) generat de server ---
            var responseContent = await uploadResponse.Content.ReadAsStringAsync();
            string serverFileName = "";

            // Verificăm dacă răspunsul este JSON sau text simplu
            if (responseContent.Trim().StartsWith("{"))
            {
                var uploadResult = await uploadResponse.Content.ReadFromJsonAsync<ImageUploadResult>();
                serverFileName = uploadResult?.ImagePath ?? "";
            }
            else
            {
                serverFileName = responseContent.Trim().Split('\n').Last().Trim('"');
            }

            if (string.IsNullOrWhiteSpace(serverFileName) || serverFileName.Length < 3)
            {
                serverFileName = selectedFile.Name;
            }

            Console.WriteLine($"DEBUG: Nume salvat pe server: {serverFileName}");

            // --- PASUL 3: Crearea obiectului curat pentru baza de date ---
            // Modifică doar partea de creare a obiectului din SaveItem:
            // --- PASUL 3: Crearea obiectului curat pentru baza de date ---
            // --- PASUL 3: Crearea obiectului curat pentru baza de date ---
            var userEmail = await LocalStorage.GetItemAsync<string>("userEmail");
            var currentSub = SubcategoriesFromDb.FirstOrDefault(s => s.Id == selectedSubcategoryId);
            if (currentSub != null) subcategory = currentSub.Name;
            // 2. Creăm obiectul cu TOATE datele necesare bazei de date
            var newItem = new ClothingItem
            {
                Name = $"{brand} {subcategory}".Trim(),
                Brand = brand,
                CategoryId = selectedCategoryId,
                SubcategoryId = selectedSubcategoryId,
                CategoryName = category,        // Important pentru filtrele din Closet
                SubcategoryName = subcategory,
                Season = season,
                Style = style,
                ImagePath = serverFileName,
                UserId = userEmail ?? "unknown_user", // <--- DACĂ E GOL, PUNEM UN STRING CA SĂ NU DEA EROARE DB
                Color = color
            };
            // 4. Salvăm haina prin serviciu
            // 1. Trimitem direct prin Client ca să vedem răspunsul serverului
            var response = await Client.PostAsJsonAsync("api/clothing", newItem);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("SUCCES: Haina a fost salvată în baza de date!");
                await WardrobeService.InitializeAsync(forceReload: true);
                NavigationManager.NavigateTo("/closet?success=true");
                return;
            }
            else
            {
                var errorDetails = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"EROARE SERVER: {response.StatusCode} - {errorDetails}");
                Toast.Show($"Eroare la salvare: {response.StatusCode}", "error");
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"EROARE LA SALVARE: {ex.Message}");
            Toast.Show("Eroare neașteptată la salvare!", "error");
        }
    }

