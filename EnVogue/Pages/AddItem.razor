        /* 3. Spațiul sub Logo (Distanța până la Search/Conținut) */
        .editorial-header, .header-nav {
            margin-bottom: clamp(20px, 4vh, 35px) !important;
        }

        .editorial-header-unified {
            height: 80px;
            padding-top: 20px !important;
