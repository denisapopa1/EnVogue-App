@page "/add-item"
@inject IJSRuntime JSRuntime
@inject EnVogue.Services.NotificationService Toast
@using EnVogue.Services
@using EnVogue.Models
@implements IDisposable

<div class="page-container with-nav">
    <div class="card card-glass animate-fade-in form-limit">
        <h3 class="center" style="margin-bottom: 10px;">Upload a Photo</h3>
        <p class="page-subtitle center" style="margin-bottom: 16px;">Take or upload a photo of your clothing item</p>
        <input type="file" id="fileInput" accept="image/*" style="display: none;" @ref="fileInput" />

        <div class="dropzone" @onclick="TriggerFileInput">
            @if (string.IsNullOrEmpty(imagePreview))
            {
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" style="margin: 0 auto 12px;">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p style="font-weight: 600; margin-bottom: 4px;">Click to upload</p>
                <p class="page-subtitle">or drag and drop</p>
            }
            else
            {
                <img src="@imagePreview" alt="Preview" style="max-width: 100%; max-height: 300px; border-radius: 12px;" />
                <p style="margin-top: 10px; color: var(--accent); font-weight: 600;">Click to change</p>
            }
        </div>
        @* Brand Field cu spațiere corectată *@
        <div class="input-group" style="margin-top: 24px;">
            <label>Brand</label>
            <input type="text" class="input-field" @bind="brand" placeholder="e.g. Zara, Nike, Gucci..." />
        </div>
        <div class="input-group">
            <label>Category</label>
            <select class="input-field" @onchange="OnCategoryChanged">
                @foreach (var cat in MainCategories)
                {
                    <option value="@cat" selected="@(cat == category)">@cat</option>
                }
            </select>
        </div>

        <div class="input-group">
            <label>Subcategory</label>
            <select class="input-field" @bind="subcategory" disabled="@(!AvailableSubcategories.Any())">
                @if (!AvailableSubcategories.Any())
                {
                    <option value="" disabled>Select a main category first</option>
                }
                @foreach (var sub in AvailableSubcategories)
                {
                    <option value="@sub">@sub</option>
                }
            </select>
        </div>

        <div class="input-group">
            <label>Season</label>
            <select class="input-field" @bind="season">
                @foreach (var s in Seasons)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <div class="input-group">
            <label>Style (Optional)</label>
            <select class="input-field" @bind="style">
                <option value="">None / Not specified</option>
                @foreach (var s in Styles)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <div class="input-group">
            <label>Color</label>
            <input type="text" class="input-field" placeholder="E.g., Blue, Red, Black" @bind="color" />
        </div>

        <button class="btn-primary" style="width: 100%; margin-top: 20px;" @onclick="SaveItem">Save Item</button>
    </div>
</div>

<NavBar CurrentPage="home" />

@code {
    private List<string> MainCategories = new List<string> { "Tops", "Bottoms", "Dress", "Outerwear", "Shoes", "Accessories" };
    private List<string> Seasons = new List<string> { "Summer", "Winter", "Spring", "Autumn" };
    private List<string> Styles = new List<string> { "Casual", "Elegant", "Sport", "Business" };

    private Dictionary<string, List<string>> SubcategoryMap = new Dictionary<string, List<string>>
    {
        { "Tops", new List<string> { "T-shirt", "Blouse", "Hoodie", "Sweater" } },
        { "Bottoms", new List<string> { "Jeans", "Trousers", "Skirt", "Shorts" } },
        { "Dress", new List<string> { "Cocktail", "Maxi", "Mini", "Evening" } },
        { "Outerwear", new List<string> { "Jacket", "Coat", "Blazer", "Vest" } },
        { "Shoes", new List<string> { "Sneakers", "Boots", "Sandals", "Heels" } },
        { "Accessories", new List<string> { "Scarf", "Belt", "Jewelry", "Hat" } }
    };

    // Variabile de stare
    private string brand = ""; // 💡 Fix: Am adăugat variabila locală
    private string category = "Tops";
    private string subcategory = "";
    private string season = "Summer";
    private string style = "";
    private string color = "";
    private string imagePreview = "";
    private List<string> AvailableSubcategories = new List<string>();

    private ElementReference fileInput;
    private DotNetObjectReference<AddItem>? objRef;

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private WardrobeServices WardrobeService { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (SubcategoryMap.ContainsKey(category))
        {
            AvailableSubcategories = SubcategoryMap[category];
            subcategory = AvailableSubcategories.FirstOrDefault() ?? "";
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        category = e.Value?.ToString() ?? "Tops";
        AvailableSubcategories = SubcategoryMap.ContainsKey(category) ? SubcategoryMap[category] : new List<string>();
        subcategory = AvailableSubcategories.FirstOrDefault() ?? "";
    }

    private void SaveItem()
    {
        if (string.IsNullOrEmpty(imagePreview) || string.IsNullOrEmpty(category) || string.IsNullOrEmpty(subcategory))
        {
            // OPȚIONAL: Notificare de eroare dacă lipsesc date
            Toast.Show("Please upload a photo and select a category", "error");
            return;
        }

        var item = new ClothingItem
        {
            Brand = brand, // 💡 Salvăm brandul aici
            Category = category,
            Subcategory = subcategory,
            Season = season,
            Style = style,
            Color = color,
            ImageData = imagePreview,
       
        };

        WardrobeService.AddClothingItem(item);
        // 💡 ADAUGĂ ACEASTĂ LINIE ÎNAINTE DE NAVIGARE
        Toast.Show("Item added to your wardrobe!");
        NavigationManager.NavigateTo("/closet");
    }

    private async Task TriggerFileInput()
    {
        await JSRuntime.InvokeVoidAsync("fileUpload.triggerFileInput", "fileInput");
    }

    [JSInvokable]
    public void OnFileSelected(string base64Data)
    {
        imagePreview = base64Data;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("fileUpload.initializeFileInput", "fileInput", objRef);
        }
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}