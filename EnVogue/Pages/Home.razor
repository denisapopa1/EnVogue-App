@page "/home"
@layout EmptyLayout
@using EnVogue.Models
@using EnVogue.Services
@inject NavigationManager NavigationManager
@inject WardrobeServices WardrobeService

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&family=Inter:wght@400;700;800&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
        outline: none !important;
    }

    .app-container {
        width: 100vw;
        height: 100vh;
        overflow-y: auto;
        overflow-x: hidden;
        background-color: #fce7f3;
        font-family: 'Inter', sans-serif;
    }
</style>

<div class="app-container">
    <div class="hero-section">
        <div class="hero-overlay">
            <div class="header-nav">

                <div class="brand-text-block">

                    <h1 class="brand-title-unified no-border">EnVogue</h1>

                    <span class="collection-tag-unified closet-color">DIGITAL WARDROBE</span>

                </div>
                <button class="profile-circle" @onclick='() => NavigationManager.NavigateTo("/profile")'>
                    <svg viewBox="0 0 24 24" class="profile-svg">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    </svg>
                </button>
            </div>
            <div class="hero-body">
                @* Tagline setat pe negru conform cerinței *@
                <span class="hero-tag" style="color: #7a5c68; font-weight: 800; letter-spacing: 3px; font-size: 13px;">THE FUTURE OF STYLE</span>
                <h1 class="hero-title">Fashion<br />Simplified.</h1>
                <p class="hero-desc">Manage your personal collection<br />with AI-driven intelligence.</p>
                <div class="explore-btn" @onclick='() => NavigationManager.NavigateTo("/closet")'>
                    <span class="explore-txt">EXPLORE WARDROBE</span>
                    <div class="arrow-cerc">→</div>
                </div>
            </div>
        </div>
        <div class="bottom-fade-gradient"></div>
    </div>

    <div class="scrolling-full-view">
        <div class="box-card welcome-box">
            <span class="label-badge">WELCOME BACK</span>
            @* Afișare dinamică a numelui extras din mail *@
            <h2 class="user-greet-black">Hello, @userName</h2>
            <p class="sub-desc">Your digital closet is ready. It's time to refine your signature style for the day.</p>
        </div>

        <div class="box-card stats-box">
            <div class="stat-item"><span class="val-num">@totalItems</span><span class="val-txt">ITEMS</span></div>
            <div class="stat-item"><span class="val-num">@favoriteCount</span><span class="val-txt">FAVORITES</span></div>
            <div class="stat-item"><span class="val-num">@categoriesCount</span><span class="val-txt">CATEGORIES</span></div>
        </div>

        <div class="box-card action-dark" @onclick='() => NavigationManager.NavigateTo("/create-outfit")'>
            <div class="icon-wrap"><svg viewBox="0 0 24 24" class="sparkle-identic"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z" /></svg></div>
            <div class="action-info"><h3>Create Outfit</h3><p>Let AI suggest your next iconic look.</p></div>
        </div>

        <div class="box-card action-dashed" @onclick='() => NavigationManager.NavigateTo("/add-item")'>
            <div class="plus-pink">+</div>
            <div class="action-info"><h3 class="black-text">Add New Item</h3><p class="black-text-sub">Expand your digital collection.</p></div>
        </div>
    </div>

    <div class="extra-scroll-content">
        <div class="section-group">
            <div class="section-header-left">
                <h2 class="serif-section-title">Your Outfits</h2>
                <span class="section-subtitle-tag">CURATED LOOKS</span>
            </div>
            <div class="empty-state-card">
                <div class="grid-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                </div>
                <p class="empty-msg">No outfits created yet. Start your styling journey.</p>
                <button class="action-pill-btn" @onclick='() => NavigationManager.NavigateTo("/create-outfit")'>CREATE FIRST OUTFIT</button>
            </div>
        </div>

        <div class="section-group">
            <div class="section-header-row">
                <h2 class="serif-section-title">New In</h2>
                <span class="archive-link" @onclick='() => NavigationManager.NavigateTo("/closet")'>ARCHIVE</span>
            </div>
            <div class="horizontal-items-container">
                @if (recentItems.Any())
                {
                    @foreach (var item in recentItems)
                    {
                        @* Adăugăm @onclick pentru navigare directă către ID-ul produsului *@
                        <div class="clothing-item-tile" @onclick='() => NavigationManager.NavigateTo($"/item-details/{item.Id}")'>
                            @* Trimitem ImagePath în loc de ImageData *@
                            <img src="@GetImageSource(item.ImagePath)" alt="recent item" />
                        </div>
                    }
                }
                else
                {
                    <div class="no-items-placeholder"><p>No new items added recently.</p></div>
                }
            </div>
        </div>
        <div class="bottom-spacer"></div>
    </div>

    <NavBar CurrentPage="home" />
</div>

<style>
