@code {
    private int totalItems;
    private int favoriteCount;
    private int categoriesCount;
    private string userName = "User";
    private List<ClothingItem> recentItems = new List<ClothingItem>();
    private List<Outfit> recentOutfits = new List<Outfit>();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var userEmail = WardrobeService.GetLoggedInUserEmail();
        if (userEmail == "Guest")
        {
            await WardrobeService.InitializeAsync();
            userEmail = WardrobeService.GetLoggedInUserEmail();
        }

        if (userEmail == "Guest")
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await WardrobeService.InitializeAsync();

        // Luăm toate hainele
        var all = WardrobeService.GetAllClothes();
        var allOutfits = WardrobeService.GetAllOutfits();

        // --- REPARARE DATE (Pentru afișare corectă în "New In") ---
        foreach (var item in all)
        {
            if (string.IsNullOrEmpty(item.CategoryName) && item.CategoryId.HasValue)
            {
                item.CategoryName = item.CategoryId switch
                {
                    1 => "Tops",
                    2 => "Bottoms",
                    3 => "Shoes",
                    4 => "Accessories",
                    5 => "Dress",
                    6 => "Outerwear",
                    _ => "Unknown"
                };
            }
        }

        totalItems = all.Count;
        favoriteCount = all.Count(i => i.IsFavorite);
        categoriesCount = all.Select(c => c.CategoryName).Distinct().Count();

        // Luăm mai multe elemente pentru carusel
        recentItems = all.OrderByDescending(i => i.Id).Take(12).ToList();
        recentOutfits = allOutfits
            .Where(ShouldAppearOnHomeOutfits)
            .OrderByDescending(o => o.CreatedDate == default ? DateTime.MinValue : o.CreatedDate)
            .ThenByDescending(o => o.Id)
            .Take(12)
            .ToList();

        // Logica pentru nume utilizator
        var parts = userEmail.Split('@');
        if (parts.Length > 0 && !string.IsNullOrEmpty(parts[0]))
        {
            var rawName = parts[0];
            userName = char.ToUpper(rawName[0]) + (rawName.Length > 1 ? rawName.Substring(1) : "");
        }

        isLoading = false;
    }
    // --- REPARAȚIE IMAGINI: Calea de pe Backend (7081) ---
    private string GetImageSource(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath) || imagePath == "du")
            return "Images/placeholder.png";

        // Dacă path-ul are deja http, îl lăsăm așa
        if (imagePath.StartsWith("http")) return imagePath;

        // Extragem doar numele fișierului pentru a fi siguri
        var fileName = System.IO.Path.GetFileName(imagePath);

        // CONSTRUCȚIA CORECTĂ A URL-ULUI (trebuie să includă folderul de pe server)
        return $"https://localhost:7081/uploads/images/{fileName}";
    }

    private static IEnumerable<ClothingItem?> GetOutfitPreviewItems(Outfit outfit)
    {
        var items = (outfit.ClothingItems ?? new List<ClothingItem>())
            .Take(4)
            .Cast<ClothingItem?>()
            .ToList();

        while (items.Count < 4)
        {
            items.Add(null);
        }

        return items;
    }

    private static string GetOutfitDisplayName(Outfit outfit)
        => string.IsNullOrWhiteSpace(outfit.Name) ? "Untitled outfit" : outfit.Name;

    private static string GetOutfitStyleLabel(Outfit outfit)
        => string.IsNullOrWhiteSpace(outfit.Occasion) ? "Manual Selection" : outfit.Occasion!;

    private static string GetOutfitItemCountLabel(Outfit outfit)
    {
        var count = outfit.ClothingItems?.Count ?? 0;
        return count == 1 ? "1 item" : $"{count} items";
    }

    private static string GetOutfitDateLabel(Outfit outfit)
        => outfit.CreatedDate == default ? "Recent" : outfit.CreatedDate.ToString("MMM dd");

    private static bool ShouldAppearOnHomeOutfits(Outfit outfit)
    {
        return outfit.Items.Any() &&
               (string.IsNullOrWhiteSpace(outfit.CreationSource) ||
                string.Equals(outfit.CreationSource, "Manual", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(outfit.CreationSource, "AI", StringComparison.OrdinalIgnoreCase));
    }
}
