<div class="nav-bar">
    <a href="/home" class="@NavItemClass("home")" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        </svg>
        <span>Home</span>
    </a>

    <a href="/closet" class="@NavItemClass("closet")" aria-label="My Closet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
        <span>My Closet</span>
    </a>

    <a href="/add-item" class="nav-item fab-center" aria-label="Add Item">
        <div class="fab">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </div>
    </a>

    <a href="/create-outfit" class="@NavItemClass("create")" aria-label="Create Outfit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
        <span>Create</span>
    </a>

    <a href="/favorites" class="@NavItemClass("favorites")" aria-label="Favorites">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span>Favorites</span>
    </a>
</div>
<style>
    /* Eliminăm culoarea albastră de hover pentru toate link-urile din nav-bar */
    .nav-bar a.nav-item {
        text-decoration: none;
        transition: all 0.3s ease;
    }

        /* Stilul de Hover Personalizat */
        .nav-bar a.nav-item:hover {
            color: #d946ef; /* Schimbăm în rozul EnVogue în loc de albastru */
            transform: translateY(-2px); /* Un mic efect de ridicare la hover */
        }

            /* Asigurăm că și iconițele SVG își schimbă culoarea la hover */
            .nav-bar a.nav-item:hover svg {
                stroke: #d946ef;
            }

    /* Stil special pentru butonul central FAB (cel cu Plus) la hover */
    .fab-center:hover .fab {
        transform: scale(1.1) rotate(90deg); /* Se mărește și se rotește discret */
    }

    /* Menținem culoarea activă dacă pagina este selectată */
    .nav-item.active {
        color: #d946ef !important;
    }

        .nav-item.active svg {
            stroke: #d946ef !important;
        }
</style>
@code {
    [Parameter]
    public string CurrentPage { get; set; } = "";

    private string NavItemClass(string page)
        => CurrentPage == page
            ? "nav-item active"
            : "nav-item";
}
