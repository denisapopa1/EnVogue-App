<style>
    .nav-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 85px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 10px 15px;
        border-top: 1px solid #fce7f3;
        z-index: 1000;
    }

    .nav-side {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    .nav-side-left {
        padding-right: 42px;
    }

    .nav-side-right {
        padding-left: 42px;
    }

    .nav-item {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: #7a5c68;
        transition: all 0.3s ease;
    }

        .nav-item svg {
            width: 20px;
            height: 20px;
            margin-bottom: 4px;
        }

        .nav-item span {
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .fab-center {
        position: absolute;
        left: 50%;
        top: 0;
        flex: 0 0 65px;
        transform: translateX(-50%);
        z-index: 1001;
    }

    .fab {
        width: 50px;
        height: 50px;
        background: #d946ef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 8px 20px rgba(217, 70, 239, 0.4);
        border: 4px solid white;
        margin-top: -35px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .nav-item:hover {
        color: #d946ef;
        transform: translateY(-2px);
    }

    .nav-item.fab-center:hover {
        transform: translateX(-50%);
    }

    .nav-item.active {
        color: #d946ef !important;
    }

        .nav-item.active svg {
            stroke: #d946ef !important;
        }

    .fab-center:hover .fab {
        transform: scale(1.1) rotate(90deg);
        background: #c026d3;
    }
</style>

@code {
    [Parameter] public string CurrentPage { get; set; } = "";

    private string NavItemClass(string page)
        => CurrentPage == page ? "nav-item active" : "nav-item";
}
